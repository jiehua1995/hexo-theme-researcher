<div class="flex flex-col h-full">
  <!-- Profile -->
  <div class="p-6 pb-5">
    <a href="<%= url_for('/') %>" class="flex items-center gap-4 no-underline group">
      <span class="rc-avatar-ring" style="--rc-av-size: 4.25rem;">
        <img src="<%= url_for(theme.avatar) %>" alt="Profile" class="rc-avatar" />
      </span>
      <span class="min-w-0">
        <span class="block rc-serif text-lg font-bold text-base-content truncate group-hover:text-[color-mix(in_oklab,var(--rc-accent)_80%,transparent)] transition-colors"><%= config.author %></span>
        <% if (config.subtitle) { %>
          <span class="block text-sm rc-muted truncate"><%= config.subtitle %></span>
        <% } %>
      </span>
    </a>
  </div>

  <!-- Menu -->
  <nav class="px-4 py-3 space-y-0.5 flex-grow overflow-y-auto">
    <% if (theme.menu && Array.isArray(theme.menu)) { %>
      <% theme.menu.forEach(function(item) { %>
        <a href="<%= url_for(item.url) %>" class="rc-sidebar-link">
          <span class="rc-sidebar-icon"><i class="<%= item.icon %>"></i></span>
          <span class="rc-sidebar-text"><%= item.name %></span>
        </a>
      <% }); %>
    <% } %>
  </nav>

  <!-- Social -->
  <div class="p-5 mt-auto border-t" style="border-color: color-mix(in oklab, var(--rc-line) 70%, transparent);">
    <div class="flex justify-center items-center gap-2">
      <% if (theme.academic_profiles.google_scholar) { %>
        <a href="<%= theme.academic_profiles.google_scholar %>" class="rc-social" target="_blank" rel="noopener noreferrer" title="Google Scholar">
          <i class="fa-brands fa-google-scholar text-xl block"></i>
        </a>
      <% } %>
      <% if (theme.academic_profiles.orcid) { %>
        <a href="<%= theme.academic_profiles.orcid %>" class="rc-social" target="_blank" rel="noopener noreferrer" title="ORCID">
          <i class="fa-brands fa-orcid text-xl block"></i>
        </a>
      <% } %>
      <% if (theme.academic_profiles.researchgate) { %>
        <a href="<%= theme.academic_profiles.researchgate %>" class="rc-social" target="_blank" rel="noopener noreferrer" title="ResearchGate">
          <i class="fa-brands fa-researchgate text-xl block"></i>
        </a>
      <% } %>
      <% if (theme.academic_profiles.github) { %>
        <a href="<%= theme.academic_profiles.github %>" class="rc-social" target="_blank" rel="noopener noreferrer" title="GitHub">
          <i class="fa-brands fa-github text-xl block"></i>
        </a>
      <% } %>
      <% if (theme.academic_profiles.linkedin) { %>
        <a href="<%= theme.academic_profiles.linkedin %>" class="rc-social" target="_blank" rel="noopener noreferrer" title="LinkedIn">
          <i class="fa-brands fa-linkedin text-xl block"></i>
        </a>
      <% } %>
      <% if (theme.academic_profiles.twitter) { %>
        <a href="<%= theme.academic_profiles.twitter %>" class="rc-social" target="_blank" rel="noopener noreferrer" title="Twitter">
          <i class="fa-brands fa-twitter text-xl block"></i>
        </a>
      <% } %>
    </div>
  </div>
</div>
