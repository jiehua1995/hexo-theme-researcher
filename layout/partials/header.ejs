<script>document.documentElement.classList.add('js');</script>
<!-- Meta tags -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%
// 如果是单页/文章，则使用 page.title，否则使用站点主标题
const pageTitle = (page && page.title) ? page.title : config.title;
const pageDescription = (page && page.description) ? page.description : config.description;
const pageUrl = (page && page.path) ? config.url + url_for(page.path) : config.url;
%>

<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDescription %>">
<meta name="keywords" content="<%= config.keywords %>">
<meta name="author" content="<%= config.author %>">

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="<%- url_for('images/favicon.ico') %>">

<!-- Open Graph tags -->
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDescription %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= pageUrl %>">

<!-- Twitter Card tags -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDescription %>">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;540;560;600;620;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap">

<!-- Academicons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">

<!-- Tailwind CSS + Design System -->
<link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/design.css') %>">

<!-- Theme Change Script -->
<script src="https://cdn.jsdelivr.net/npm/theme-change@2.0.2/index.js"></script>

<!-- Typed -->
<script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
