<div class="rc-cookie" id="rcCookie" role="dialog" aria-live="polite" hidden>
  <div class="rc-cookie-card">
    <div class="rc-cookie-icon">🍪</div>
    <div class="rc-cookie-text">
      <strong>We value your privacy</strong>
      <span>This website may use cookies to remember your theme, local weather and site preferences. By continuing to browse, you agree to the use of cookies.</span>
    </div>
    <div class="rc-cookie-actions">
      <button class="rc-btn rc-btn-accent rc-btn-sm" id="rcCookieAccept" type="button">Accept</button>
      <button class="rc-btn rc-btn-ghost rc-btn-sm" id="rcCookieReject" type="button">Reject</button>
    </div>
  </div>
</div>
