<div class="rc-section">
  <header class="rc-section-head">
    <span class="rc-kicker">Publications</span>
    <h1 class="rc-section-title">Selected publications</h1>
    <p class="rc-muted mt-3 max-w-2xl">Peer-reviewed articles and preprints. Use the filters to narrow by year, category or keyword.</p>
  </header>

  <!-- Filters -->
  <div class="rc-filter" data-filter>
    <div class="rc-filter-field">
      <label class="rc-filter-label" for="yearFilter">Year</label>
      <select class="rc-select w-full" id="yearFilter" name="yearFilter" data-filter-type="year">
        <option value="">All Years</option>
        <%
          const years = [...new Set(site.data.publications.map(p => p.year))].sort((a, b) => b - a);
          years.forEach(year => {
        %>
          <option value="<%= year %>"><%= year %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field">
      <label class="rc-filter-label" for="categoryFilter">Category</label>
      <select class="rc-select w-full" id="categoryFilter" name="categoryFilter" data-filter-type="category">
        <option value="">All Categories</option>
        <%
          const categories = [...new Set(site.data.publications.map(p => p.category))].filter(c => c).sort();
          categories.forEach(category => {
        %>
          <option value="<%= category %>"><%= category %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field grow">
      <label class="rc-filter-label" for="searchInput">Search</label>
      <input type="text" placeholder="Search publications..." class="rc-input w-full" id="searchInput" data-filter-type="search" />
    </div>
  </div>

  <!-- Publications list -->
  <div id="publicationsList" class="space-y-7" data-filter-list>
    <% site.data.publications.forEach(function(pub) { %>
      <div class="publication-item rc-reveal" data-filter-item
           data-year="<%= pub.year %>"
           data-category="<%= (pub.category || '').toLowerCase() %>"
           data-tags="<%= pub.tags ? pub.tags.join(',') : '' %>"
           data-title="<%= (pub.title || '').toLowerCase() %>"
           data-text="<%= ((pub.authors || '') + ' ' + (pub.venue || '') + ' ' + (pub.abstract || '')).toLowerCase() %>">
        <article class="rc-card rc-focus">
          <div class="rc-card-body p-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-semibold leading-tight flex-1"><%= pub.title %></h2>
              <% if (pub.type) { %>
                <span class="rc-badge shrink-0 mt-1"><%= pub.type %></span>
              <% } %>
            </div>

            <% if (pub.authors) { %>
              <p class="text-sm font-medium text-base-content/90 mb-3"><%= pub.authors %></p>
            <% } %>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm rc-muted mb-4">
              <% if (pub.venue) { %>
                <span class="flex items-center gap-1.5">
                  <i class="fa-solid fa-building w-4 h-4"></i>
                  <%= pub.venue %>
                </span>
              <% } %>
              <% if (pub.year) { %>
                <span class="flex items-center gap-1.5">
                  <i class="fa-solid fa-calendar-week w-4 h-4"></i>
                  <%= pub.year %>
                </span>
              <% } %>
              <% if (pub.category) { %>
                <span class="flex items-center gap-1.5">
                  <i class="fa-solid fa-layer-group w-4 h-4"></i>
                  <%= pub.category %>
                </span>
              <% } %>
            </div>

            <% if (pub.tags && pub.tags.length) { %>
              <div class="flex flex-wrap gap-2 mb-4">
                <% pub.tags.forEach(tag => { %>
                  <span class="rc-tag"><%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <% if (pub.abstract) { %>
              <p class="text-sm leading-relaxed text-base-content/80 mb-5"><%= pub.abstract %></p>
            <% } %>

            <div class="flex flex-wrap gap-2">
              <% if (pub.doi) { %>
                <a href="https://doi.org/<%= pub.doi %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer" title="DOI">
                  <i class="fa-solid fa-link w-4 h-4"></i> DOI
                </a>
              <% } %>
              <% if (pub.pdf) { %>
                <a href="<%= pub.pdf %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer" title="PDF">
                  <i class="fa-solid fa-file-pdf w-4 h-4"></i> PDF
                </a>
              <% } %>
              <% if (pub.code) { %>
                <a href="<%= pub.code %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer" title="Code">
                  <i class="fa-solid fa-code w-4 h-4"></i> Code
                </a>
              <% } %>
              <% if (pub.website) { %>
                <a href="<%= pub.website %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer" title="Project Website">
                  <i class="fa-solid fa-globe w-4 h-4"></i> Website
                </a>
              <% } %>
            </div>
          </div>
        </article>
      </div>
    <% }); %>
  </div>
</div>
