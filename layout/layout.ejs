<!DOCTYPE html>
<html lang="<%= config.language %>" data-theme="light">
<head>
  <%- partial('partials/header') %>
</head>
<body class="min-h-screen">

  <!-- Sidebar for Desktop (own full-height column, left) -->
  <aside class="rc-sidebar hidden lg:flex fixed left-0 top-0 h-screen w-80 z-40 flex-col overflow-y-auto">
    <div class="relative h-full">
      <%- partial('partials/sidebar') %>
    </div>

    <%- partial('partials/ads') %>
  </aside>

  <!-- Drawer for Mobile -->
  <div class="drawer lg:hidden">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col">
      <!-- Mobile navbar -->
      <div class="rc-nav w-full navbar fixed top-0 left-0 right-0 z-40">
        <label for="my-drawer" class="rc-nav-icon" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
               viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <div class="flex-1 flex items-center px-3">
          <%- partial('partials/weather') %>
        </div>
        <div class="flex-none">
          <%- partial('partials/themes') %>
        </div>
      </div>
    </div>

    <!-- Sidebar drawer panel for mobile -->
    <div class="drawer-side z-60">
      <label for="my-drawer" class="drawer-overlay"></label>
      <aside class="rc-sidebar w-80 min-h-full overflow-y-auto">
        <div class="relative h-full">
          <%- partial('partials/sidebar') %>
        </div>
      </aside>
    </div>
  </div>

  <!-- Content area for Desktop (whole-body partial swapping via Swup) -->
  <div id="swup" class="lg:ml-80 pt-20 px-4 lg:px-10 pb-8">
    <%- body %>
  </div>

  <!-- Fixed top navbar for desktop (right of the sidebar, above the content only) -->
  <div class="rc-nav hidden lg:flex fixed top-0 left-80 right-0 z-50 h-16 items-center px-4 lg:px-8">
    <div class="flex-1 flex items-center px-2">
      <%- partial('partials/weather') %>
    </div>
    <div class="flex-none">
      <%- partial('partials/themes') %>
    </div>
  </div>

  <!-- Footer, 页面只出现一次 -->
  <footer class="mt-auto">
    <%- partial('partials/footer') %>
  </footer>

  <!-- back to top -->
  <%- partial('partials/back_to_top') %>

  <!-- cookie consent -->
  <%- partial('partials/cookie_consent') %>

  <!-- MathJax for mathematical formulas -->
  <script>
    MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true,
        processEnvironments: true
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'],
        ignoreHtmlClass: 'tex2jax_ignore',
        processHtmlClass: 'tex2jax_process'
      },
      startup: {
        ready: () => {
          MathJax.startup.defaultReady();
        },
        pageReady: () => {
          MathJax.startup.defaultPageReady().then(() => {
            // Clean up $$ delimiters after rendering
            setTimeout(() => {
              const walker = document.createTreeWalker(
                document.querySelector('.post-content') || document.body,
                NodeFilter.SHOW_TEXT,
                null,
                false
              );

              let textNode;
              const nodesToUpdate = [];

              while (textNode = walker.nextNode()) {
                if (textNode.nodeValue.includes('$$') &&
                    textNode.parentNode.querySelector('mjx-container[display="true"]')) {
                  nodesToUpdate.push(textNode);
                }
              }

              nodesToUpdate.forEach(node => {
                node.nodeValue = node.nodeValue.replace(/\$\$/g, '');
              });
            }, 100);
          });
        }
      }
    };
  </script>
  <script type="text/javascript" id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <!-- Motion + nav active state (exposed so Swup can re-run it after a swap) -->
  <script>
    function __rcSetActive() {
      var path = location.pathname.replace(/\/(index)?$/, '') || '/';
      document.querySelectorAll('.rc-sidebar-link').forEach(function (link) {
        var href = (link.getAttribute('href') || '').replace(/\/(index)?$/, '') || '/';
        link.classList.toggle('is-active', href === path);
      });
    }

    function __rcInitToc() {
      __rcInitToc.links = Array.prototype.slice.call(document.querySelectorAll('.rc-toc-link[data-toc-target]'));
      __rcInitToc.list = __rcInitToc.links.length ? __rcInitToc.links[0].closest('.rc-toc-list') : null;
      __rcInitToc.container = __rcInitToc.links.length ? __rcInitToc.links[0].closest('.rc-toc') : null;
      __rcInitToc.lastActive = -1;
      __rcInitToc.shift = 0; // reset the centring offset — a stale value from a previous
                             // (longer) list would corrupt the first frame after a Swup swap
      if (!__rcInitToc.bound) {
        __rcInitToc.bound = true;

        function updateToc() {
          var links = __rcInitToc.links || [];
          if (!links.length) return;
          // Track the SECTION currently occupying the MIDDLE of the viewport --
          // i.e. the deepest entry whose heading has scrolled past the vertical
          // centre line. This feels more natural than tracking the top.
          var mid = window.innerHeight * 0.5;
          var activeIndex = 0;
          links.forEach(function (link, i) {
            var t = document.getElementById(link.getAttribute('data-toc-target'));
            if (t && t.getBoundingClientRect().top <= mid) activeIndex = i;
          });
          // emphasis (colour + font-size) is class-driven; only swap it when the
          // active section actually changes so we don't churn layout every frame
          if (__rcInitToc.lastActive !== activeIndex) {
            __rcInitToc.lastActive = activeIndex;
            links.forEach(function (link, i) {
              link.classList.toggle('is-active', i === activeIndex);
            });
          }
          // Centre the active entry inside the focus window (screen centre), but
          // clamp the shift so the list always fills its window (never shows an
          // empty gap). Otherwise a short list (e.g. CV) drifts oddly and a long
          // list jumps at the top/bottom ends — which reads as "not smooth".
          var list = __rcInitToc.list;
          var container = __rcInitToc.container;
          var activeEl = links[activeIndex];
          if (list && container && activeEl) {
            var item = activeEl.closest('.rc-toc-item') || activeEl;
            var cRect = container.getBoundingClientRect();
            var cCenter = cRect.top + cRect.height * 0.5;
            var prev = __rcInitToc.shift || 0;
            var lRect = list.getBoundingClientRect();
            var listTop = lRect.top - prev;         // natural (unshifted) bounds
            var listBottom = lRect.bottom - prev;
            var itemRect = item.getBoundingClientRect();
            var itemCenter = itemRect.top + itemRect.height * 0.5 - prev;
            var target = cCenter - itemCenter;
            var minShift = cRect.bottom - listBottom; // largest up-shift (no bottom gap)
            var maxShift = cRect.top - listTop;       // largest down-shift (no top gap)
            var shift = Math.max(minShift, Math.min(maxShift, target));
            list.style.transform = 'translateY(' + shift + 'px)';
            __rcInitToc.shift = shift;
          }
        }

        __rcInitToc.update = updateToc;
        // throttle to animation frames so the scroll never janks
        function requestToc() {
          if (__rcInitToc.raf) return;
          __rcInitToc.raf = requestAnimationFrame(function () {
            __rcInitToc.raf = 0;
            updateToc();
          });
        }
        __rcInitToc.request = requestToc;
        window.addEventListener('scroll', requestToc, { passive: true });
        window.addEventListener('resize', requestToc, { passive: true });
        window.addEventListener('load', updateToc);

        // Clicking a TOC entry (or any in-page #anchor) should land the heading
        // about mid-screen, not tucked under the fixed top bar (issue: too high).
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest && ev.target.closest('a[href^="#"]');
          if (!a) return;
          var hash = a.getAttribute('href');
          if (!hash || hash === '#' || hash.length < 2) return;
          var target = document.getElementById(hash.slice(1));
          if (!target) return;
          ev.preventDefault();
          var y = target.getBoundingClientRect().top + window.pageYOffset - window.innerHeight * 0.42;
          window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
        });
      }
      if (__rcInitToc.update) __rcInitToc.update();
    }

    function __rcInitFilters() {
      var page = document.getElementById('swup') || document;
      Array.prototype.forEach.call(page.querySelectorAll('[data-filter]'), function (scope) {
        // Guard so re-init (after a Swup swap) never double-binds live controls.
        if (scope.getAttribute('data-f-inited')) { /* keep listening on a live scope */ }
        function bind() {
          var list = page.querySelector('[data-filter-list]');
          var items = list ? Array.prototype.slice.call(list.querySelectorAll('[data-filter-item]')) : [];
          if (!items.length) return;
          var controls = {
            status: scope.querySelector('[data-filter-type="status"]'),
            category: scope.querySelector('[data-filter-type="category"]'),
            year: scope.querySelector('[data-filter-type="year"]'),
            search: scope.querySelector('[data-filter-type="search"]')
          };
          var countEl = page.querySelector('[data-filter-count]');
          var emptyEl = page.querySelector('[data-filter-empty]');
          var catParam = new URLSearchParams(location.search).get('category');
          var tagParam = new URLSearchParams(location.search).get('tag');
          if (catParam && controls.category) controls.category.value = catParam;

          function normalizeList(v) {
            return (v || '').toLowerCase().split(',').map(function (s) { return s.trim(); }).filter(Boolean);
          }
          function apply() {
            var cat = (controls.category && controls.category.value) || '';
            var year = (controls.year && controls.year.value) || '';
            var status = (controls.status && controls.status.value) || '';
            var q = (controls.search ? controls.search.value : '').toLowerCase().trim();
            var shown = 0;
            items.forEach(function (item) {
              var okSt = !status || (item.getAttribute('data-status') || '') === status;
              var okCat = !cat || normalizeList(item.getAttribute('data-category')).indexOf(cat.toLowerCase()) > -1;
              var okYear = !year || (item.getAttribute('data-year') || '') === year;
              var okTag = !tagParam || normalizeList(item.getAttribute('data-tags')).indexOf(tagParam.toLowerCase()) > -1;
              var text = [
                item.getAttribute('data-title'), item.getAttribute('data-text'),
                item.getAttribute('data-tags'), item.getAttribute('data-category'),
                item.getAttribute('data-year')
              ].join(' ').toLowerCase();
              var okSearch = !q || text.indexOf(q) > -1;
              var show = okSt && okCat && okYear && okTag && okSearch;
              item.style.display = show ? '' : 'none';
              if (show) shown++;
            });
            if (countEl) countEl.textContent = shown === items.length ? ('Showing all ' + items.length) : ('Found ' + shown);
            if (emptyEl) emptyEl.classList.toggle('hidden', shown > 0);
          }
          if (controls.status) controls.status.addEventListener('change', apply);
          if (controls.category) controls.category.addEventListener('change', apply);
          if (controls.year) controls.year.addEventListener('change', apply);
          if (controls.search) controls.search.addEventListener('input', apply);
          apply();
        }
        scope.setAttribute('data-f-inited', '1');
        bind();
      });
    }

    // Detail / Compact view switching on list pages (Publications, Projects,
    // Talks). Reads the last choice from localStorage and applies `.rc-list--compact`
    // to the matching `[data-view]` container, so it survives a Swup swap too.
    function __rcInitViews() {
      var page = document.getElementById('swup') || document;
      Array.prototype.forEach.call(page.querySelectorAll('[data-view]'), function (list) {
        var toggle = page.querySelector('[data-view-toggle]');
        var key = list.getAttribute('data-view-key') || 'rc-view';
        var saved = null;
        try { saved = window.localStorage.getItem(key); } catch (e) {}
        function apply(mode) {
          mode = mode === 'compact' ? 'compact' : 'detail';
          list.setAttribute('data-view', mode);
          list.classList.toggle('rc-list--compact', mode === 'compact');
          if (toggle) {
            Array.prototype.forEach.call(toggle.querySelectorAll('[data-view-mode]'), function (btn) {
              var active = btn.getAttribute('data-view-mode') === mode;
              btn.classList.toggle('is-active', active);
              btn.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
          }
          try { window.localStorage.setItem(key, mode); } catch (e) {}
        }
        if (toggle && !toggle.getAttribute('data-v-inited')) {
          toggle.setAttribute('data-v-inited', '1');
          Array.prototype.forEach.call(toggle.querySelectorAll('[data-view-mode]'), function (btn) {
            btn.addEventListener('click', function () { apply(btn.getAttribute('data-view-mode')); });
          });
        }
        apply(saved || 'detail');
      });
    }

    function __rcInitMotion() {
      // Reveal: fade every section in. All `.rc-reveal` are marked visible so
      // content can never be stuck hidden (no blank page), no matter how the
      // page was reached — direct load, Swup swap or back/forward cache. The
      // scroll scaling / 3D effect is driven by .rc-focus below, not by this.
      Array.prototype.forEach.call(document.querySelectorAll('.rc-reveal'), function (el) {
        if (!el.classList.contains('is-visible')) el.classList.add('is-visible');
      });

      // Scroll-focus: cards near the viewport centre grow + glow, edges shrink
      // out. Reads the CURRENT focus elements each run so it survives swaps.
      __rcInitMotion.focusEls = Array.prototype.slice.call(document.querySelectorAll('.rc-focus'));
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (__rcInitMotion.focusEls.length && 'IntersectionObserver' in window && !reduced) {
        if (!__rcInitMotion.bound) {
          __rcInitMotion.bound = true;
          __rcInitMotion.vh = window.innerHeight || 800;
          __rcInitMotion.raf = null;
          function updateFocus() {
            var mid = __rcInitMotion.vh * 0.5;
            var range = Math.max(__rcInitMotion.vh * 0.95, 470);
            (__rcInitMotion.focusEls || []).forEach(function (el) {
              var rect = el.getBoundingClientRect();
              var center = rect.top + rect.height * 0.5;
              var dist = Math.abs(center - mid);
              var f = Math.max(0, Math.min(1, 1 - dist / range));
              // smoothstep easing so transitions between scale states feel seamless
              var e = f * f * (3 - 2 * f);
              el.style.setProperty('--fs', (0.9 + e * 0.12).toFixed(3));
              el.style.setProperty('--fo', (0.82 + e * 0.18).toFixed(3));
              el.style.setProperty('--fc', e.toFixed(3));
              if (e > 0.58) el.setAttribute('data-focus', 'center');
              else el.removeAttribute('data-focus');
            });
            __rcInitMotion.raf = null;
          }
          function requestFocus() {
            if (__rcInitMotion.raf === null) __rcInitMotion.raf = requestAnimationFrame(updateFocus);
          }
          __rcInitMotion.request = requestFocus;
          window.addEventListener('scroll', requestFocus, { passive: true });
          window.addEventListener('resize', function () { __rcInitMotion.vh = window.innerHeight; requestFocus(); }, { passive: true });
          window.addEventListener('load', requestFocus);
        }
        __rcInitMotion.request();
      }
    }

    var __rcMotionWatcher = null;

    document.addEventListener('DOMContentLoaded', function () {
      __rcInitMotion();
      __rcSetActive();
      __rcInitToc();
      __rcInitFilters();
      __rcInitViews();

      // Re-run motion after ANY swap of the #swup content. Swup's own
      // content:replace event is not reliably fired across Swup versions, so we
      // watch the container via a MutationObserver instead — this is bulletproof
      // and means a page can never stay blank after navigating.
      if (document.body && 'MutationObserver' in window && !__rcMotionWatcher) {
        var mTimer = null;
        __rcMotionWatcher = new MutationObserver(function () {
          if (mTimer) clearTimeout(mTimer);
          mTimer = window.setTimeout(function () {
            __rcInitMotion();
            __rcSetActive();
            __rcInitToc();
            __rcInitFilters();
            __rcInitViews();
            // Re-run the post content pipeline (math/code/table conversion) so a
            // Swup-swapped article renders formulas without a manual refresh.
            if (window.__rcProcessPost) { try { window.__rcProcessPost(); } catch (e) {} }
            if (window.MathJax && window.MathJax.typesetPromise) {
              try { window.MathJax.typesetPromise(); } catch (e) {}
            }
          }, 60);
        });
        __rcMotionWatcher.observe(document.body, { childList: true, subtree: true });
      }
    });
  </script>

  <!-- Navbar info widget: live clock + weather (auto or custom city) -->
  <script>
    (function () {
      if (!document.querySelector('.rc-nav-widget')) return;
      var icons = document.querySelectorAll('.rc-w-icon');
      var temps = document.querySelectorAll('.rc-w-temp');
      var cities = document.querySelectorAll('.rc-w-city');
      if (!icons.length) return;

      function setWeather(i, t, c) {
        icons.forEach(function (el) { el.textContent = i; });
        temps.forEach(function (el) { el.textContent = t; });
        cities.forEach(function (el) { el.textContent = c || ''; });
      }
      function weatherIcon(code) {
        var m = { 0:'☀️',1:'🌤',2:'⛅',3:'☁️',45:'🌫',48:'🌫',51:'🌦',53:'🌦',55:'🌧',61:'🌧',63:'🌧',65:'🌧',66:'🌧',67:'🌧',71:'🌨',73:'🌨',75:'❄️',77:'❄️',80:'🌦',81:'🌧',82:'⛈',85:'🌨',86:'🌨',95:'⛈',96:'⛈',99:'⛈' };
        return m[code] || '🌤';
      }

      // ---- live clock (computer time), all instances ----
      var timeEls = document.querySelectorAll('.rc-time');
      var dateEls = document.querySelectorAll('.rc-date');
      function tick() {
        var d = new Date();
        var t = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        var dt = d.toLocaleDateString([], { month: 'short', day: 'numeric' });
        timeEls.forEach(function (el) { el.textContent = t; });
        dateEls.forEach(function (el) { el.textContent = dt; });
      }
      tick();
      setInterval(tick, 15000);

      // ---- weather by lat/lon ----
      function fetchWeather(lat, lon, name) {
        return fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat +
          '&longitude=' + lon + '&current_weather=true&timezone=auto')
          .then(function (r) { return r.json(); })
          .then(function (w) {
            if (w.current_weather) setWeather(weatherIcon(w.current_weather.weathercode), Math.round(w.current_weather.temperature) + '°C', name);
          });
      }
      // ---- geocode + set a custom city (persisted) ----
      function setCustomCity(name) {
        return fetch('https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(name) +
          '&count=1&language=en&format=json')
          .then(function (r) { return r.json(); })
          .then(function (g) {
            var res = g.results && g.results[0];
            if (!res) throw new Error('not found');
            var label = res.name + (res.country ? ', ' + res.country : '');
            return fetchWeather(res.latitude, res.longitude, label).then(function () {
              try { localStorage.setItem('rcWeather', JSON.stringify({ name: label, lat: res.latitude, lon: res.longitude })); } catch (e) {}
            });
          });
      }
      // ---- auto-detect via geolocation ----
      function autoDetect() {
        if (!('geolocation' in navigator)) { setWeather('🌤', '--°C', ''); return; }
        navigator.geolocation.getCurrentPosition(function (pos) {
          var lat = pos.coords.latitude, lon = pos.coords.longitude;
          fetch('https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=' + lat +
            '&longitude=' + lon + '&localityLanguage=en')
            .then(function (r) { return r.json(); })
            .then(function (geo) {
              var cname = geo.city || geo.locality || geo.principalSubdivision || '';
              return fetchWeather(lat, lon, cname);
            })
            .catch(function () { return fetchWeather(lat, lon, ''); });
        }, function () { setWeather('🌤', '--°C', ''); }, { timeout: 8000, maximumAge: 600000 });
      }

      // ---- init: restore saved city, else auto-detect ----
      var saved = null;
      try { saved = localStorage.getItem('rcWeather'); } catch (e) {}
      if (saved) {
        try {
          var s = JSON.parse(saved);
          fetchWeather(s.lat, s.lon, s.name);
        } catch (e) { autoDetect(); }
      } else {
        autoDetect();
      }

      // ---- city picker popover (per instance) ----
      document.querySelectorAll('.rc-weather-wrap').forEach(function (wrap) {
        var btn = wrap.querySelector('.rc-weather');
        var pop = wrap.querySelector('.rc-widget-pop');
        var input = wrap.querySelector('.rc-city-input');
        var go = wrap.querySelector('.rc-city-go');
        var auto = wrap.querySelector('.rc-city-auto');
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          pop.hidden = !pop.hidden;
          if (!pop.hidden) { input.value = ''; input.placeholder = 'City (e.g. Berlin)'; input.focus(); }
        });
        pop.addEventListener('click', function (e) { e.stopPropagation(); });
        go.addEventListener('click', function () {
          var v = input.value.trim();
          if (!v) return;
          setCustomCity(v)
            .then(function () { pop.hidden = true; })
            .catch(function () { input.placeholder = 'City not found'; input.select(); });
        });
        auto.addEventListener('click', function () {
          try { localStorage.removeItem('rcWeather'); } catch (e) {}
          autoDetect();
          pop.hidden = true;
        });
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') go.click(); });
        document.addEventListener('click', function (e) {
          if (!wrap.contains(e.target)) pop.hidden = true;
        });
      });
    })();
  </script>

  <!-- Cookie consent -->
  <script>
    (function () {
      var el = document.getElementById('rcCookie');
      if (!el) return;
      var KEY = 'rcCookieConsent';
      var saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      if (saved) return;
      el.hidden = false;
      var close = function (v) {
        try { localStorage.setItem(KEY, v); } catch (e) {}
        el.hidden = true;
      };
      var ok = document.getElementById('rcCookieAccept');
      var no = document.getElementById('rcCookieReject');
      if (ok) ok.addEventListener('click', function () { close('accepted'); });
      if (no) no.addEventListener('click', function () { close('rejected'); });
    })();
  </script>

  <!-- Swup: SPA-style partial navigation — swap only #swup so the fixed
       sidebar / navbar never re-render. Falls back to normal full loads. -->
  <script src="https://cdn.jsdelivr.net/npm/swup@4/dist/Swup.umd.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof Swup === 'undefined' || !document.getElementById('swup')) return;
      try {
        var swup = new Swup({
          containers: ['#swup'],
          cache: false,
          animateHistoryBrowsing: false,
          linkSelector: 'a[href]:not([data-no-swup]):not([target="_blank"]):not([href^="#"]):not([href^="mailto:"]):not([href^="tel:"]):not([download])'
        });
        swup.on('content:replace', function () {
          window.__rcInitMotion && window.__rcInitMotion();
          if (window.MathJax && window.MathJax.typesetPromise) {
            try { window.MathJax.typesetPromise(); } catch (e) {}
          }
        });
        swup.on('page:view', function () {
          // history is updated by now, so location.pathname is correct
          window.__rcSetActive && window.__rcSetActive();
        });
      } catch (e) { /* if Swup fails, normal navigation still works */ }
    });
  </script>

  <!-- Loaded globally so the post content pipeline (math/code/tables) can be
       re-run after a Swup navigation; post.js guards itself on non-post pages. -->
  <script src="https://cdn.jsdelivr.net/npm/clipboard@2.0.11/dist/clipboard.min.js"></script>
  <script src="<%= url_for('/js/post.js') %>"></script>

</body>
</html>
