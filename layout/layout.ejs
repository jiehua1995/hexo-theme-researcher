<!DOCTYPE html>
<html lang="<%= config.language %>" data-theme="light">
<head>
  <%- partial('partials/header') %>
</head>
<body class="min-h-screen flex flex-col <%= (theme.appearance && theme.appearance.neumorphism === false) ? '' : 'rc-neu-on' %>">

  <!-- Fluid cloud: slow, heavily blurred colour blobs behind the content -->
  <% if (!theme.appearance || theme.appearance.fluid_cloud !== false) { %>
    <div class="rc-cloud" aria-hidden="true">
      <span class="rc-cloud-blob rc-cloud-a"></span>
      <span class="rc-cloud-blob rc-cloud-b"></span>
      <span class="rc-cloud-blob rc-cloud-c"></span>
    </div>
  <% } %>

  <!-- Reading progress line (top edge) + cursor spotlight (decorative) -->
  <div class="rc-progress" aria-hidden="true"><span id="rc-progress-bar"></span></div>
  <div class="rc-spotlight" aria-hidden="true"></div>

  <!-- Sidebar for Desktop (own full-height column, left) -->
  <aside class="rc-sidebar hidden lg:flex fixed left-0 top-0 h-screen w-80 z-40 flex-col overflow-y-auto">
    <div class="relative h-full">
      <%- partial('partials/sidebar') %>
    </div>

    <%- partial('partials/ads') %>
  </aside>

  <!-- Drawer for Mobile -->
  <div class="drawer lg:hidden">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col">
      <!-- Mobile navbar -->
      <div class="rc-nav w-full navbar fixed top-0 left-0 right-0 z-40">
        <label for="my-drawer" class="rc-nav-icon" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
               viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <div class="flex-1 flex items-center px-3">
          <%- partial('partials/weather') %>
        </div>
        <div class="flex-none">
          <%- partial('partials/themes') %>
        </div>
      </div>
    </div>

    <!-- Sidebar drawer panel for mobile -->
    <div class="drawer-side z-60">
      <label for="my-drawer" class="drawer-overlay"></label>
      <aside class="rc-sidebar w-80 min-h-full overflow-y-auto">
        <div class="relative h-full">
          <%- partial('partials/sidebar') %>
        </div>
      </aside>
    </div>
  </div>

  <!-- Content area for Desktop (whole-body partial swapping via Swup) -->
  <div id="swup" class="lg:ml-80 pt-20 px-4 lg:px-10 pb-8 flex-1 min-h-0">
    <%- body %>
  </div>

  <!-- Fixed top navbar for desktop (right of the sidebar, above the content only) -->
  <div class="rc-nav hidden lg:flex fixed top-0 left-80 right-0 z-50 h-16 items-center px-4 lg:px-8">
    <div class="flex-1 flex items-center px-2">
      <%- partial('partials/weather') %>
    </div>
    <div class="flex-none">
      <%- partial('partials/themes') %>
    </div>
  </div>

  <!-- Footer, 页面只出现一次 -->
  <footer class="mt-auto">
    <%- partial('partials/footer') %>
  </footer>

  <!-- back to top -->
  <%- partial('partials/back_to_top') %>

  <!-- cookie consent -->
  <%- partial('partials/cookie_consent') %>

  <!-- MathJax for mathematical formulas -->
  <script>
    MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true,
        processEnvironments: true
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'],
        ignoreHtmlClass: 'tex2jax_ignore',
        processHtmlClass: 'tex2jax_process'
      },
      startup: {
        ready: () => {
          MathJax.startup.defaultReady();
        },
        pageReady: () => {
          MathJax.startup.defaultPageReady().then(() => {
            // Clean up $$ delimiters after rendering
            setTimeout(() => {
              const walker = document.createTreeWalker(
                document.querySelector('.post-content') || document.body,
                NodeFilter.SHOW_TEXT,
                null,
                false
              );

              let textNode;
              const nodesToUpdate = [];

              while (textNode = walker.nextNode()) {
                if (textNode.nodeValue.includes('$$') &&
                    textNode.parentNode.querySelector('mjx-container[display="true"]')) {
                  nodesToUpdate.push(textNode);
                }
              }

              nodesToUpdate.forEach(node => {
                node.nodeValue = node.nodeValue.replace(/\$\$/g, '');
              });
            }, 100);
          });
        }
      }
    };
  </script>
  <script type="text/javascript" id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <!-- Motion + nav active state (exposed so Swup can re-run it after a swap) -->
  <script>
    function __rcSetActive() {
      var path = location.pathname.replace(/\/(index)?$/, '') || '/';
      document.querySelectorAll('.rc-sidebar-link').forEach(function (link) {
        var href = (link.getAttribute('href') || '').replace(/\/(index)?$/, '') || '/';
        link.classList.toggle('is-active', href === path);
      });
    }

    function __rcInitToc() {
      __rcInitToc.links = Array.prototype.slice.call(document.querySelectorAll('.rc-toc-link[data-toc-target]'));
      __rcInitToc.list = __rcInitToc.links.length ? __rcInitToc.links[0].closest('.rc-toc-list') : null;
      __rcInitToc.container = __rcInitToc.links.length ? __rcInitToc.links[0].closest('.rc-toc') : null;
      __rcInitToc.lastActive = -1;
      __rcInitToc.shift = 0; // reset the centring offset — a stale value from a previous
                             // (longer) list would corrupt the first frame after a Swup swap
      if (!__rcInitToc.bound) {
        __rcInitToc.bound = true;

        function updateToc() {
          var links = __rcInitToc.links || [];
          if (!links.length) return;
          // Track the SECTION currently occupying the MIDDLE of the viewport --
          // i.e. the deepest entry whose heading has scrolled past the vertical
          // centre line. This feels more natural than tracking the top.
          var mid = window.innerHeight * 0.5;
          var activeIndex = 0;
          links.forEach(function (link, i) {
            var t = document.getElementById(link.getAttribute('data-toc-target'));
            if (t && t.getBoundingClientRect().top <= mid) activeIndex = i;
          });
          // emphasis (colour + font-size) is class-driven; only swap it when the
          // active section actually changes so we don't churn layout every frame
          if (__rcInitToc.lastActive !== activeIndex) {
            __rcInitToc.lastActive = activeIndex;
            links.forEach(function (link, i) {
              link.classList.toggle('is-active', i === activeIndex);
            });
          }
          // Centre the active entry inside the focus window (screen centre), but
          // clamp the shift so the list always fills its window (never shows an
          // empty gap). Otherwise a short list (e.g. CV) drifts oddly and a long
          // list jumps at the top/bottom ends — which reads as "not smooth".
          var list = __rcInitToc.list;
          var container = __rcInitToc.container;
          var activeEl = links[activeIndex];
          if (list && container && activeEl) {
            var item = activeEl.closest('.rc-toc-item') || activeEl;
            var cRect = container.getBoundingClientRect();
            var cCenter = cRect.top + cRect.height * 0.5;
            var prev = __rcInitToc.shift || 0;
            var lRect = list.getBoundingClientRect();
            var listTop = lRect.top - prev;         // natural (unshifted) bounds
            var listBottom = lRect.bottom - prev;
            var itemRect = item.getBoundingClientRect();
            var itemCenter = itemRect.top + itemRect.height * 0.5 - prev;
            var target = cCenter - itemCenter;
            var minShift = cRect.bottom - listBottom; // largest up-shift (no bottom gap)
            var maxShift = cRect.top - listTop;       // largest down-shift (no top gap)
            var shift = Math.max(minShift, Math.min(maxShift, target));
            list.style.transform = 'translateY(' + shift + 'px)';
            __rcInitToc.shift = shift;
          }
        }

        __rcInitToc.update = updateToc;
        // throttle to animation frames so the scroll never janks
        function requestToc() {
          if (__rcInitToc.raf) return;
          __rcInitToc.raf = requestAnimationFrame(function () {
            __rcInitToc.raf = 0;
            updateToc();
          });
        }
        __rcInitToc.request = requestToc;
        window.addEventListener('scroll', requestToc, { passive: true });
        window.addEventListener('resize', requestToc, { passive: true });
        window.addEventListener('load', updateToc);

        // Clicking a TOC entry (or any in-page #anchor) should land the heading
        // about mid-screen, not tucked under the fixed top bar (issue: too high).
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest && ev.target.closest('a[href^="#"]');
          if (!a) return;
          var hash = a.getAttribute('href');
          if (!hash || hash === '#' || hash.length < 2) return;
          var target = document.getElementById(hash.slice(1));
          if (!target) return;
          ev.preventDefault();
          var y = target.getBoundingClientRect().top + window.pageYOffset - window.innerHeight * 0.42;
          window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
        });
      }
      if (__rcInitToc.update) __rcInitToc.update();
    }

    function __rcInitFilters() {
      var page = document.getElementById('swup') || document;
      Array.prototype.forEach.call(page.querySelectorAll('[data-filter]'), function (scope) {
        // Guard so re-init (after a Swup swap) never double-binds live controls.
        if (scope.getAttribute('data-f-inited')) { /* keep listening on a live scope */ }
        function bind() {
          var list = page.querySelector('[data-filter-list]');
          var items = list ? Array.prototype.slice.call(list.querySelectorAll('[data-filter-item]')) : [];
          if (!items.length) return;
          var controls = {
            status: scope.querySelector('[data-filter-type="status"]'),
            category: scope.querySelector('[data-filter-type="category"]'),
            year: scope.querySelector('[data-filter-type="year"]'),
            search: scope.querySelector('[data-filter-type="search"]')
          };
          var countEl = page.querySelector('[data-filter-count]');
          var emptyEl = page.querySelector('[data-filter-empty]');
          var catParam = new URLSearchParams(location.search).get('category');
          if (catParam && controls.category) controls.category.value = catParam;

          function normalizeList(v) {
            return (v || '').toLowerCase().split(',').map(function (s) { return s.trim(); }).filter(Boolean);
          }
          // Split a comma-separated attribute WITHOUT lower-casing — used for tag
          // names, which are case-sensitive (a tag named "Testing" is distinct
          // from "testing"). Categories are matched case-insensitively via
          // normalizeList() above.
          function splitList(v) {
            return (v || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
          }
          // Tags the user has toggled in the interactive tag cloud. The tag cloud
          // is the single source of truth for tag filtering, so the exact tag
          // names (preserving case) are returned here — this is what makes a
          // `?tag=X` arrival both highlight the pill AND apply the filter in one
          // consistent place.
          function selectedTags() {
            var out = [];
            Array.prototype.forEach.call(page.querySelectorAll('[data-tagcloud] .rc-tagcloud-item.is-active'), function (b) {
              var t = b.getAttribute('data-tag');
              if (t && out.indexOf(t) < 0) out.push(t);
            });
            return out;
          }
          function apply() {
            var cat = (controls.category && controls.category.value) || '';
            var year = (controls.year && controls.year.value) || '';
            var status = (controls.status && controls.status.value) || '';
            var q = (controls.search ? controls.search.value : '').toLowerCase().trim();
            var selTags = selectedTags();
            var shown = 0;
            items.forEach(function (item) {
              var okSt = !status || (item.getAttribute('data-status') || '') === status;
              var okCat = !cat || normalizeList(item.getAttribute('data-category')).indexOf(cat.toLowerCase()) > -1;
              var okYear = !year || (item.getAttribute('data-year') || '') === year;
              var itemTags = splitList(item.getAttribute('data-tags'));
              var okTag = !selTags.length || itemTags.some(function (t) { return selTags.indexOf(t) > -1; });
              var text = [
                item.getAttribute('data-title'), item.getAttribute('data-text'),
                item.getAttribute('data-tags'), item.getAttribute('data-category'),
                item.getAttribute('data-year')
              ].join(' ').toLowerCase();
              var okSearch = !q || text.indexOf(q) > -1;
              var show = okSt && okCat && okYear && okTag && okSearch;
              item.style.display = show ? '' : 'none';
              if (show) shown++;
            });
            if (countEl) countEl.textContent = shown === items.length ? ('Showing all ' + items.length) : ('Found ' + shown);
            if (emptyEl) emptyEl.classList.toggle('hidden', shown > 0);
            window.__rcFilterApply = apply; // let the tag cloud re-run the same filter
          }
          if (controls.status) controls.status.addEventListener('change', apply);
          if (controls.category) controls.category.addEventListener('change', apply);
          if (controls.year) controls.year.addEventListener('change', apply);
          if (controls.search) controls.search.addEventListener('input', apply);
          apply();
        }
        scope.setAttribute('data-f-inited', '1');
        bind();
      });
    }

    // Set a card's expanded state and sync its chevron. This is the single
    // source of truth for detail visibility (see .rc-card[data-expanded] CSS).
    // A collapsed card shows only the title + own badge + key meta + Dimensions
    // badge; an expanded card reveals the full detail + Altmetric badge too.
    function __rcSetCardExpanded(card, expanded) {
      expanded = !!expanded;
      card.setAttribute('data-expanded', expanded ? 'true' : 'false');
      var btn = card.querySelector('.rc-expand');
      if (btn) {
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        var icon = btn.querySelector('i');
        if (icon) icon.className = expanded ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
      }
    }

    // Detail / Compact view switching on list pages (Publications, Projects,
    // Talks, Notes). Reads the last choice from localStorage and applies
    // `.rc-list--compact` to the matching `[data-view]` container, so it survives
    // a Swup swap too. Switching mode RESETS every card to that mode's default
    // state (Compact → all collapsed, Detail → all expanded).
    function __rcInitViews() {
      var f = (window.themeConfig && window.themeConfig.features) || {};
      if (f.view_toggle === false) return;
      var page = document.getElementById('swup') || document;
      Array.prototype.forEach.call(page.querySelectorAll('[data-view]'), function (list) {
        var toggle = page.querySelector('[data-view-toggle]');
        var key = list.getAttribute('data-view-key') || 'rc-view';
        var cards = Array.prototype.slice.call(list.querySelectorAll('.rc-card'));
        var saved = null;
        try { saved = window.localStorage.getItem(key); } catch (e) {}
        function apply(mode, force) {
          mode = mode === 'compact' ? 'compact' : 'detail';
          list.setAttribute('data-view', mode);
          list.classList.toggle('rc-list--compact', mode === 'compact');
          // force=true (an explicit toggle click) resets EVERY card to the mode's
          // default. On a re-init we only set the default for cards that have
          // never been touched, preserving any per-card expand/collapse the user
          // made (otherwise the MutationObserver would undo a manual expand).
          cards.forEach(function (c) {
            if (force || !c.hasAttribute('data-expanded')) __rcSetCardExpanded(c, mode === 'detail');
          });
          if (toggle) {
            Array.prototype.forEach.call(toggle.querySelectorAll('[data-view-mode]'), function (btn) {
              var active = btn.getAttribute('data-view-mode') === mode;
              btn.classList.toggle('is-active', active);
              btn.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
          }
          try { window.localStorage.setItem(key, mode); } catch (e) {}
        }
        if (toggle && !toggle.getAttribute('data-v-inited')) {
          toggle.setAttribute('data-v-inited', '1');
          Array.prototype.forEach.call(toggle.querySelectorAll('[data-view-mode]'), function (btn) {
            btn.addEventListener('click', function () { apply(btn.getAttribute('data-view-mode'), true); });
          });
        }
        apply(saved || 'detail', false);
      });
    }

    // Re-scan for Altmetric / Dimensions citation badges. Their embed scripts are
    // loaded globally and self-initialise on first load; after a Swup swap the
    // container elements are new, so we ask each library to re-scan the DOM.
    function __rcInitBadges() {
      var f = (window.themeConfig && window.themeConfig.features) || {};
      if (f.citation_badges === false) return;
      if (window.__dimensions_embed && window.__dimensions_embed.addBadges) {
        try { window.__dimensions_embed.addBadges(); } catch (e) {}
      }
      if (typeof window._altmetric_embed_init === 'function') {
        try { window._altmetric_embed_init(); } catch (e) {}
      }
      // Hide any badge that has no data. The Dimensions embed fetches metrics
      // asynchronously and shows a "?" placeholder when a DOI has no records, so
      // poll for a short while and drop the empty badges the user asked to hide.
      var checks = 0;
      var timer = setInterval(function () {
        checks++;
        var anyHidden = false;
        Array.prototype.forEach.call(document.querySelectorAll('.__dimensions_badge_embed__'), function (el) {
          if (el.style.display === 'none') return;
          var link = el.querySelector('a.__dimensions_Link');
          var label = link ? (link.getAttribute('aria-label') || '') : '';
          var m = label.match(/(\d+)\s*total citations/i);
          var hasData = !!m && Number(m[1]) > 0;
          if (link && !hasData) { el.style.display = 'none'; anyHidden = true; }
          // no anchor yet means the fetch is still in-flight → wait another tick
        });
        // Hide a whole row only when BOTH badges are empty: the Dimensions one is
        // hidden above AND the Altmetric one rendered nothing (no mentions). Re-show
        // if content later arrives, so we never hide a badge that was just slow.
        if (checks >= 2) {
          Array.prototype.forEach.call(document.querySelectorAll('.rc-cite-badges'), function (row) {
            var anyVisible = false;
            Array.prototype.forEach.call(row.children, function (c) {
              if (c.style.display === 'none') return;
              if (c.classList.contains('altmetric-embed')) {
                if (c.childElementCount > 0) anyVisible = true;
              } else {
                anyVisible = true;
              }
            });
            if (!anyVisible) { row.style.display = 'none'; anyHidden = true; }
            else if (row.style.display === 'none') { row.style.display = ''; }
          });
        }
        if (checks >= 12 || !anyHidden) clearInterval(timer);
      }, 700);
    }

    // Per-card expand/collapse. Each card carries a chevron (visible in EVERY
    // mode); clicking toggles the card's `data-expanded` so the full detail
    // content appears or folds back in place.
    function __rcInitExpand() {
      var page = document.getElementById('swup') || document;
      Array.prototype.forEach.call(page.querySelectorAll('.rc-expand'), function (btn) {
        if (btn.getAttribute('data-ex-inited')) return;
        btn.setAttribute('data-ex-inited', '1');
        var card = btn.closest('.rc-card');
        if (!card) return;
        btn.addEventListener('click', function () {
          __rcSetCardExpanded(card, card.getAttribute('data-expanded') !== 'true');
        });
      });
    }

    // Interactive tag cloud (Notes): buttons toggle selection and re-run the SAME
    // page filter (no reload), so the notes grid updates live. Selection colour
    // is class-driven (.is-active); a "Clear selection" button appears when needed.
    function __rcInitTagCloud() {
      var f = (window.themeConfig && window.themeConfig.features) || {};
      if (f.tag_cloud === false) return;
      var page = document.getElementById('swup') || document;
      Array.prototype.forEach.call(page.querySelectorAll('[data-tagcloud]'), function (cloud) {
        var clearBtn = page.querySelector('[data-tag-clear]');
        function selectedNames() {
          return Array.prototype.map.call(cloud.querySelectorAll('.rc-tagcloud-item.is-active'), function (b) {
            return b.getAttribute('data-tag');
          }).filter(Boolean);
        }
        function refreshClear() {
          var any = cloud.querySelectorAll('.rc-tagcloud-item.is-active').length > 0;
          if (clearBtn) clearBtn.hidden = !any;
        }
        function refresh() {
          if (window.__rcFilterApply) { try { window.__rcFilterApply(); } catch (e) {} }
        }
        // keep the URL in sync so the current tags can be shared / bookmarked
        function syncUrl() {
          try {
            var names = selectedNames();
            var sp = new URLSearchParams(location.search);
            if (names.length) sp.set('tag', names.join(','));
            else sp.delete('tag');
            var qs = sp.toString();
            history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
          } catch (e) {}
        }
        // Rebuild the selection from the current `?tag=…` URL params. Runs on
        // EVERY init (not just the first), so even if Swup updates the history
        // a little after the DOM swap, the next re-init re-highlights the pill.
        // Tags are matched by exact name (case-sensitive) — "Testing" and
        // "testing" are distinct tags, so only the one the user picked lights up.
        function syncFromUrl() {
          var initial = new URLSearchParams(location.search).get('tag');
          Array.prototype.forEach.call(cloud.querySelectorAll('.rc-tagcloud-item'), function (b) {
            b.classList.remove('is-active');
          });
          if (initial) {
            initial.split(',').forEach(function (t) {
              t = t.trim();
              if (!t) return;
              Array.prototype.forEach.call(cloud.querySelectorAll('.rc-tagcloud-item'), function (btn) {
                if (btn.getAttribute('data-tag') === t) btn.classList.add('is-active');
              });
            });
          }
          refreshClear();
        }
        syncFromUrl();
        if (!cloud.getAttribute('data-tc-inited')) {
          cloud.setAttribute('data-tc-inited', '1');
          Array.prototype.forEach.call(cloud.querySelectorAll('.rc-tagcloud-item'), function (btn) {
            btn.addEventListener('click', function () {
              btn.classList.toggle('is-active');
              refreshClear();
              syncUrl();
              refresh();
            });
          });
          if (clearBtn && !clearBtn.getAttribute('data-tc-inited')) {
            clearBtn.setAttribute('data-tc-inited', '1');
            clearBtn.addEventListener('click', function () {
              Array.prototype.forEach.call(cloud.querySelectorAll('.rc-tagcloud-item'), function (b) { b.classList.remove('is-active'); });
              refreshClear();
              syncUrl();
              refresh();
            });
          }
        }
      });
    }

    function __rcInitMotion() {
      var mcfg = (window.themeConfig && window.themeConfig.motion) || {};
      var revealOn = !mcfg.reveal || mcfg.reveal.enabled !== false;
      var focusOn = !mcfg.scroll_focus || mcfg.scroll_focus.enabled !== false;

      // Reveal: fade every section in. All `.rc-reveal` are marked visible so
      // content can never be stuck hidden (no blank page), no matter how the
      // page was reached — direct load, Swup swap or back/forward cache. The
      // scroll scaling / 3D effect is driven by .rc-focus below, not by this.
      Array.prototype.forEach.call(document.querySelectorAll('.rc-reveal'), function (el) {
        if (!el.classList.contains('is-visible')) el.classList.add('is-visible');
      });
      // disable the reveal animation entirely when the config switch is off
      if (!revealOn) document.documentElement.setAttribute('data-no-reveal', '1');

      // Scroll-focus: cards near the viewport centre grow + glow, edges shrink
      // out. Reads the CURRENT focus elements each run so it survives swaps.
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (focusOn) {
        __rcInitMotion.focusEls = Array.prototype.slice.call(document.querySelectorAll('.rc-focus'));
      } else {
        __rcInitMotion.focusEls = [];
      }
      if (focusOn && __rcInitMotion.focusEls.length && 'IntersectionObserver' in window && !reduced) {
        if (!__rcInitMotion.bound) {
          __rcInitMotion.bound = true;
          __rcInitMotion.vh = window.innerHeight || 800;
          __rcInitMotion.raf = null;
          function updateFocus() {
            var mid = __rcInitMotion.vh * 0.5;
            var range = Math.max(__rcInitMotion.vh * 0.95, 470);
            (__rcInitMotion.focusEls || []).forEach(function (el) {
              var rect = el.getBoundingClientRect();
              var center = rect.top + rect.height * 0.5;
              var dist = Math.abs(center - mid);
              var f = Math.max(0, Math.min(1, 1 - dist / range));
              // smoothstep easing so transitions between scale states feel seamless
              var e = f * f * (3 - 2 * f);
              el.style.setProperty('--fs', (0.9 + e * 0.12).toFixed(3));
              el.style.setProperty('--fo', (0.82 + e * 0.18).toFixed(3));
              el.style.setProperty('--fc', e.toFixed(3));
              if (e > 0.58) el.setAttribute('data-focus', 'center');
              else el.removeAttribute('data-focus');
            });
            __rcInitMotion.raf = null;
          }
          function requestFocus() {
            if (__rcInitMotion.raf === null) __rcInitMotion.raf = requestAnimationFrame(updateFocus);
          }
          __rcInitMotion.request = requestFocus;
          window.addEventListener('scroll', requestFocus, { passive: true });
          window.addEventListener('resize', function () { __rcInitMotion.vh = window.innerHeight; requestFocus(); }, { passive: true });
          window.addEventListener('load', requestFocus);
        }
        __rcInitMotion.request();
      }
    }

    var __rcMotionWatcher = null;

    // Hero metric counters: animate 0 → target once per tile. Re-runs after a
    // Swup swap (the homepage markup is replaced) but never re-animates a tile
    // that already finished.
    function __rcInitMetrics() {
      var nodes = document.querySelectorAll('[data-rc-count]:not([data-rc-done])');
      if (!nodes.length) return;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      Array.prototype.forEach.call(nodes, function (el) {
        var target = parseFloat(el.getAttribute('data-rc-count'));
        if (isNaN(target)) { el.removeAttribute('data-rc-count'); return; }
        el.setAttribute('data-rc-done', '1');
        var fmt = function (v) { return Math.round(v).toLocaleString(); };
        if (reduced) { el.textContent = fmt(target); return; }
        var start = null;
        var dur = 900;
        var step = function (ts) {
          if (start === null) start = ts;
          var p = Math.min(1, (ts - start) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(target * eased);
          if (p < 1) requestAnimationFrame(step);
          else el.textContent = fmt(target);
        };
        requestAnimationFrame(step);
      });
    }

    // Custom theme picker (replaces the native <select>). Persists the choice
    // under the same localStorage key that the early <head> script restores.
    function __rcInitThemePickers() {
      var pickers = document.querySelectorAll('[data-theme-picker]');
      if (!pickers.length) return;
      Array.prototype.forEach.call(pickers, function (picker) {
        if (picker.getAttribute('data-inited')) return;
        picker.setAttribute('data-inited', '1');
        var btn = picker.querySelector('.rc-themepicker-btn');
        var menu = picker.querySelector('.rc-themepicker-menu');
        var label = picker.querySelector('[data-theme-label]');
        var items = picker.querySelectorAll('[data-theme-value]');
        if (!btn || !menu) return;

        function sync() {
          var cur = document.documentElement.getAttribute('data-theme') || 'light';
          Array.prototype.forEach.call(items, function (it) {
            var on = it.getAttribute('data-theme-value') === cur;
            it.classList.toggle('is-active', on);
            it.setAttribute('aria-selected', on ? 'true' : 'false');
            if (on && label) label.textContent = it.getAttribute('data-theme-name');
          });
        }
        function close() {
          menu.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
          picker.classList.remove('is-open');
        }
        function open() {
          menu.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
          picker.classList.add('is-open');
          sync();
          var active = menu.querySelector('.is-active');
          if (active && active.scrollIntoView) active.scrollIntoView({ block: 'nearest' });
        }

        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (menu.hidden) open(); else close();
        });
        Array.prototype.forEach.call(items, function (it) {
          it.addEventListener('click', function () {
            var value = it.getAttribute('data-theme-value');
            document.documentElement.setAttribute('data-theme', value);
            try { localStorage.setItem('theme', value); } catch (e) {}
            sync();
            close();
          });
        });
        document.addEventListener('click', function (e) {
          if (!picker.contains(e.target)) close();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
        sync();
      });
    }

    // Single re-init entry point: first load, Swup swaps, and Swup's own hooks
    // all call this. Exposed on window because the Swup bootstrap script is
    // defined later in the document.
    function __rcInitAll() {
      __rcInitMotion();
      __rcSetActive();
      __rcInitToc();
      __rcInitViews();
      __rcInitTagCloud();
      __rcInitFilters();
      __rcInitExpand();
      __rcInitBadges();
      __rcInitMetrics();
    }
    window.__rcInitAll = __rcInitAll;

    document.addEventListener('DOMContentLoaded', function () {
      __rcInitAll();
      __rcInitThemePickers();

      // Reading-progress line + cursor spotlight (decorative, one-time wiring).
      (function () {
        var bar = document.getElementById('rc-progress-bar');
        if (bar) {
          var pending = false;
          var update = function () {
            pending = false;
            var doc = document.documentElement;
            var max = (doc.scrollHeight - window.innerHeight) || 1;
            var p = Math.min(1, Math.max(0, window.scrollY / max));
            bar.style.transform = 'scaleX(' + p + ')';
          };
          window.addEventListener('scroll', function () {
            if (pending) return;
            pending = true;
            requestAnimationFrame(update);
          }, { passive: true });
          window.addEventListener('resize', update);
          update();
        }
        var spot = document.querySelector('.rc-spotlight');
        if (spot && window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
          var queued = false, mx = 0, my = 0;
          window.addEventListener('pointermove', function (e) {
            mx = e.clientX; my = e.clientY;
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () {
              queued = false;
              spot.style.setProperty('--rc-mx', mx + 'px');
              spot.style.setProperty('--rc-my', my + 'px');
            });
          }, { passive: true });
        }
      })();

      // On mobile, the drawer is a DaisyUI checkbox. Swup swaps only #swup and
      // never reloads the page, so after clicking a menu link the checkbox would
      // stay checked and the drawer would remain open over the new view. Uncheck
      // it whenever a menu link (anywhere in the mobile drawer) is activated.
      (function () {
        var toggle = document.getElementById('my-drawer');
        if (!toggle) return;
        Array.prototype.forEach.call(document.querySelectorAll('.drawer a.rc-sidebar-link'), function (link) {
          if (link.getAttribute('data-dr-inited')) return;
          link.setAttribute('data-dr-inited', '1');
          link.addEventListener('click', function () { toggle.checked = false; });
        });
      })();

      // Re-run the per-page init after ANY content swap. Swup replaces the
      // container node itself, so watching #swup alone is not reliable — watch
      // the body but ignore the chrome that mutates every second (clock /
      // weather) and any MathJax output. Swup's own hooks are a second,
      // independent trigger, so a page can never stay invisible.
      if (document.body && 'MutationObserver' in window && !__rcMotionWatcher) {
        var mTimer = null;
        var mathCooldown = 0;
        __rcMotionWatcher = new MutationObserver(function (records) {
          if (Date.now() < mathCooldown) return;
          var relevant = false;
          for (var i = 0; i < records.length; i++) {
            var rec = records[i];
            var t = rec.target;
            // per-second clock/weather, decorative layers, MathJax output
            if (t && t.nodeType === 1 && t.closest &&
                t.closest('.rc-nav, .rc-progress, .rc-cloud, .rc-spotlight, mjx-container, mjx-assistive-mml, .MathJax')) {
              continue;
            }
            var touched = [].concat(
              Array.prototype.slice.call(rec.addedNodes || []),
              Array.prototype.slice.call(rec.removedNodes || [])
            );
            var mathOnly = touched.length > 0;
            for (var j = 0; j < touched.length; j++) {
              var n = touched[j];
              if (!(n.nodeType === 1 && n.matches && n.matches('mjx-container, mjx-assistive-mml, .MathJax'))) {
                mathOnly = false;
              }
            }
            if (mathOnly) continue;
            relevant = true;
          }
          if (!relevant) return;
          if (mTimer) clearTimeout(mTimer);
          mTimer = window.setTimeout(function () {
            __rcInitAll();
            // Swallow the mutations typesetting itself produces (never call
            // MathJax.typesetPromise() here — the clock would retrigger it).
            mathCooldown = Date.now() + 900;
            if (window.__rcProcessPost) { try { window.__rcProcessPost(); } catch (e) {} }
          }, 60);
        });
        __rcMotionWatcher.observe(document.body, { childList: true, subtree: true });
      }
    });
  </script>

  <!-- Navbar info widget: live clock + weather (auto or custom city) -->
  <script>
    (function () {
      if (!document.querySelector('.rc-nav-widget')) return;
      var icons = document.querySelectorAll('.rc-w-icon');
      var temps = document.querySelectorAll('.rc-w-temp');
      var cities = document.querySelectorAll('.rc-w-city');
      if (!icons.length) return;

      function setWeather(i, t, c) {
        icons.forEach(function (el) { el.textContent = i; });
        temps.forEach(function (el) { el.textContent = t; });
        cities.forEach(function (el) { el.textContent = c || ''; });
      }
      function weatherIcon(code) {
        var m = { 0:'☀️',1:'🌤',2:'⛅',3:'☁️',45:'🌫',48:'🌫',51:'🌦',53:'🌦',55:'🌧',61:'🌧',63:'🌧',65:'🌧',66:'🌧',67:'🌧',71:'🌨',73:'🌨',75:'❄️',77:'❄️',80:'🌦',81:'🌧',82:'⛈',85:'🌨',86:'🌨',95:'⛈',96:'⛈',99:'⛈' };
        return m[code] || '🌤';
      }

      // ---- live clock (computer time), all instances ----
      var timeEls = document.querySelectorAll('.rc-time');
      var dateEls = document.querySelectorAll('.rc-date');
      function tick() {
        var d = new Date();
        var t = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        var dt = d.toLocaleDateString([], { month: 'short', day: 'numeric' });
        timeEls.forEach(function (el) { el.textContent = t; });
        dateEls.forEach(function (el) { el.textContent = dt; });
      }
      tick();
      setInterval(tick, 15000);

      // ---- weather by lat/lon ----
      function fetchWeather(lat, lon, name) {
        return fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat +
          '&longitude=' + lon + '&current_weather=true&timezone=auto')
          .then(function (r) { return r.json(); })
          .then(function (w) {
            if (w.current_weather) setWeather(weatherIcon(w.current_weather.weathercode), Math.round(w.current_weather.temperature) + '°C', name);
          });
      }
      // ---- geocode + set a custom city (persisted) ----
      function setCustomCity(name) {
        return fetch('https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(name) +
          '&count=1&language=en&format=json')
          .then(function (r) { return r.json(); })
          .then(function (g) {
            var res = g.results && g.results[0];
            if (!res) throw new Error('not found');
            var label = res.name + (res.country ? ', ' + res.country : '');
            return fetchWeather(res.latitude, res.longitude, label).then(function () {
              try { localStorage.setItem('rcWeather', JSON.stringify({ name: label, lat: res.latitude, lon: res.longitude })); } catch (e) {}
            });
          });
      }
      // ---- auto-detect via geolocation ----
      function autoDetect() {
        if (!('geolocation' in navigator)) { setWeather('🌤', '--°C', ''); return; }
        navigator.geolocation.getCurrentPosition(function (pos) {
          var lat = pos.coords.latitude, lon = pos.coords.longitude;
          fetch('https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=' + lat +
            '&longitude=' + lon + '&localityLanguage=en')
            .then(function (r) { return r.json(); })
            .then(function (geo) {
              var cname = geo.city || geo.locality || geo.principalSubdivision || '';
              return fetchWeather(lat, lon, cname);
            })
            .catch(function () { return fetchWeather(lat, lon, ''); });
        }, function () { setWeather('🌤', '--°C', ''); }, { timeout: 8000, maximumAge: 600000 });
      }

      // ---- init: restore saved city, else auto-detect ----
      var saved = null;
      try { saved = localStorage.getItem('rcWeather'); } catch (e) {}
      if (saved) {
        try {
          var s = JSON.parse(saved);
          fetchWeather(s.lat, s.lon, s.name);
        } catch (e) { autoDetect(); }
      } else {
        autoDetect();
      }

      // ---- city picker popover (per instance) ----
      document.querySelectorAll('.rc-weather-wrap').forEach(function (wrap) {
        var btn = wrap.querySelector('.rc-weather');
        var pop = wrap.querySelector('.rc-widget-pop');
        var input = wrap.querySelector('.rc-city-input');
        var go = wrap.querySelector('.rc-city-go');
        var auto = wrap.querySelector('.rc-city-auto');
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          pop.hidden = !pop.hidden;
          if (!pop.hidden) { input.value = ''; input.placeholder = 'City (e.g. Berlin)'; input.focus(); }
        });
        pop.addEventListener('click', function (e) { e.stopPropagation(); });
        go.addEventListener('click', function () {
          var v = input.value.trim();
          if (!v) return;
          setCustomCity(v)
            .then(function () { pop.hidden = true; })
            .catch(function () { input.placeholder = 'City not found'; input.select(); });
        });
        auto.addEventListener('click', function () {
          try { localStorage.removeItem('rcWeather'); } catch (e) {}
          autoDetect();
          pop.hidden = true;
        });
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') go.click(); });
        document.addEventListener('click', function (e) {
          if (!wrap.contains(e.target)) pop.hidden = true;
        });
      });
    })();
  </script>

  <!-- Cookie consent -->
  <script>
    (function () {
      var el = document.getElementById('rcCookie');
      if (!el) return;
      var KEY = 'rcCookieConsent';
      var saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      if (saved) return;
      el.hidden = false;
      var close = function (v) {
        try { localStorage.setItem(KEY, v); } catch (e) {}
        el.hidden = true;
      };
      var ok = document.getElementById('rcCookieAccept');
      var no = document.getElementById('rcCookieReject');
      if (ok) ok.addEventListener('click', function () { close('accepted'); });
      if (no) no.addEventListener('click', function () { close('rejected'); });
    })();
  </script>

  <!-- Swup: SPA-style partial navigation — swap only #swup so the fixed
       sidebar / navbar never re-render. Falls back to normal full loads. -->
  <script src="https://cdn.jsdelivr.net/npm/swup@4/dist/Swup.umd.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof Swup === 'undefined' || !document.getElementById('swup')) return;
      try {
        var swup = new Swup({
          containers: ['#swup'],
          cache: false,
          animateHistoryBrowsing: false,
          linkSelector: 'a[href]:not([data-no-swup]):not([target="_blank"]):not([href^="#"]):not([href^="mailto:"]):not([href^="tel:"]):not([download])'
        });
        // Re-init the swapped page. Swup 4 exposes hook callbacks; `on()` is the
        // legacy API. Both are wired so a navigation can never leave the new
        // content invisible (reveal animations start from opacity 0).
        var rcSwapTimer = null;
        function rcAfterSwap() {
          if (rcSwapTimer) clearTimeout(rcSwapTimer);
          rcSwapTimer = window.setTimeout(function () {
            if (window.__rcInitAll) window.__rcInitAll();
            if (window.__rcProcessPost) { try { window.__rcProcessPost(); } catch (e) {} }
            if (window.MathJax && typeof window.MathJax.typesetPromise === 'function') {
              try { window.MathJax.typesetPromise(); } catch (e) {}
            }
          }, 50);
        }
        if (swup.hooks && typeof swup.hooks.on === 'function') {
          swup.hooks.on('content:replace', rcAfterSwap);
          swup.hooks.on('page:view', rcAfterSwap);
        }
        if (typeof swup.on === 'function') {
          swup.on('content:replace', rcAfterSwap);
          swup.on('page:view', function () {
            rcAfterSwap();
            window.__rcSetActive && window.__rcSetActive();
          });
        }
      } catch (e) { /* if Swup fails, normal navigation still works */ }
    });
  </script>

  <!-- Global theme config (code collapse, …). Defined OUTSIDE the #swup container
       so it survives a Swup navigation — the per-page inline <script> inside a
       Swup container is NOT re-executed, which had silently disabled code folding. -->
  <script>
    window.themeConfig = {
      code_collapse: {
        enabled: <%= (theme.code_collapse && theme.code_collapse.enabled) ? 'true' : 'false' %>,
        lines: <%= (theme.code_collapse && theme.code_collapse.lines) ? theme.code_collapse.lines : 5 %>
      },
      motion: {
        background_animation: {
          enabled: <%= (theme.motion && theme.motion.background_animation && theme.motion.background_animation.enabled !== false) ? 'true' : 'false' %>,
          opacity: <%= (theme.motion && theme.motion.background_animation && typeof theme.motion.background_animation.opacity === 'number') ? theme.motion.background_animation.opacity : 0.1 %>,
          count: <%= (theme.motion && theme.motion.background_animation && typeof theme.motion.background_animation.count === 'number') ? theme.motion.background_animation.count : 18 %>,
          speed: <%= (theme.motion && theme.motion.background_animation && typeof theme.motion.background_animation.speed === 'number') ? theme.motion.background_animation.speed : 1 %>,
          size: <%= (theme.motion && theme.motion.background_animation && typeof theme.motion.background_animation.size === 'number') ? theme.motion.background_animation.size : 22 %>,
          icons: <%- JSON.stringify((theme.motion && theme.motion.background_animation && theme.motion.background_animation.icons) || ['🧪', '🧬', '🔬', '⚗️', '💡']) %>
        },
        scroll_focus: {
          enabled: <%= (theme.motion && theme.motion.scroll_focus && theme.motion.scroll_focus.enabled !== false) ? 'true' : 'false' %>
        },
        reveal: {
          enabled: <%= (theme.motion && theme.motion.reveal && theme.motion.reveal.enabled !== false) ? 'true' : 'false' %>
        }
      },
      features: {
        citation_badges: <%= (theme.features && theme.features.citation_badges !== false) ? 'true' : 'false' %>,
        tag_cloud: <%= (theme.features && theme.features.tag_cloud !== false) ? 'true' : 'false' %>,
        view_toggle: <%= (theme.features && theme.features.view_toggle !== false) ? 'true' : 'false' %>,
        post_toc: <%= (theme.features && theme.features.post_toc !== false) ? 'true' : 'false' %>
      }
    };
  </script>

  <!-- Altmetric + Dimensions citation badges. Loaded globally (when enabled) so
       they are available on any page; __rcInitBadges() re-scans after a Swup
       swap so newly-arrived publication cards render their badges. -->
  <% if (!theme.features || theme.features.citation_badges !== false) { %>
  <script async src="https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js"></script>
  <script async src="https://integration-dimensions-badge.digital-science.com/static/com/badge.js" charset="utf-8"></script>
  <% } %>

  <!-- Ambient background animation (falling science glyphs); self-gates on config. -->
  <script src="<%= url_for('/js/background.js') %>"></script>

  <!-- Loaded globally so the post content pipeline (math/code/tables) can be
       re-run after a Swup navigation; post.js guards itself on non-post pages. -->
  <script src="https://cdn.jsdelivr.net/npm/clipboard@2.0.11/dist/clipboard.min.js"></script>
  <script src="<%= url_for('/js/post.js') %>"></script>

</body>
</html>
