<%
const cvToc = ([
  { id: 'education', title: 'Education' },
  { id: 'experience', title: 'Experience' },
  { id: 'skills', title: 'Skills' },
  { id: 'awards', title: 'Awards & Honors' },
  { id: 'languages', title: 'Languages' },
  { id: 'teaching', title: 'Teaching' }
]).filter(function (item) { return theme.cv_sections && theme.cv_sections[item.id] !== false; });
%>
<div class="rc-section lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12">
  <div class="min-w-0">
  <header class="flex flex-wrap items-end justify-between gap-4 mb-10">
    <div>
      <span class="rc-kicker">Curriculum Vitae</span>
      <h1 class="rc-section-title">Experience &amp; background</h1>
    </div>
    <% if (theme.cv && theme.cv.download_link) { %>
      <a href="<%= theme.cv.download_link %>" class="rc-btn rc-btn-accent" target="_blank" rel="noopener noreferrer" title="Download PDF" download>
        <i class="fa-solid fa-file-arrow-down"></i>
        Download PDF
      </a>
    <% } %>
  </header>

  <!-- Jump to section -->
  <nav class="flex flex-wrap gap-2 mb-12">
    <% if (theme.cv_sections && theme.cv_sections.education !== false) { %>
      <a href="#education" class="rc-btn rc-btn-outline rc-btn-sm">Education</a>
    <% } %>
    <% if (theme.cv_sections && theme.cv_sections.experience !== false) { %>
      <a href="#experience" class="rc-btn rc-btn-outline rc-btn-sm">Experience</a>
    <% } %>
    <% if (theme.cv_sections && theme.cv_sections.skills !== false) { %>
      <a href="#skills" class="rc-btn rc-btn-outline rc-btn-sm">Skills</a>
    <% } %>
    <% if (theme.cv_sections && theme.cv_sections.awards !== false) { %>
      <a href="#awards" class="rc-btn rc-btn-outline rc-btn-sm">Awards</a>
    <% } %>
    <% if (theme.cv_sections && theme.cv_sections.languages !== false) { %>
      <a href="#languages" class="rc-btn rc-btn-outline rc-btn-sm">Languages</a>
    <% } %>
    <% if (theme.cv_sections && theme.cv_sections.teaching !== false) { %>
      <a href="#teaching" class="rc-btn rc-btn-outline rc-btn-sm">Teaching</a>
    <% } %>
  </nav>

  <!-- Education -->
  <% if (theme.cv_sections && theme.cv_sections.education !== false) { %>
  <section class="mb-14" id="education">
    <div class="flex items-center gap-3 mb-6">
      <span class="rc-kicker">01</span>
      <h2 class="text-2xl font-semibold">Education</h2>
    </div>
    <div class="rc-timeline">
      <% site.data.cv.education.forEach(function(edu) { %>
        <div class="rc-timeline-item rc-reveal">
          <span class="rc-timeline-dot"></span>
          <div class="rc-card rc-focus">
            <div class="rc-card-body">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold"><%= edu.degree %></h3>
                <% if (edu.period) { %><span class="rc-badge-soft shrink-0 mt-0.5"><%= edu.period %></span><% } %>
              </div>
              <p class="mt-1 text-sm font-medium text-base-content/80"><%= edu.institution %></p>
              <% if (edu.description) { %>
                <p class="mt-2 text-sm rc-muted"><%= edu.description %></p>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Professional Experience -->
  <% if (theme.cv_sections && theme.cv_sections.experience !== false) { %>
  <section class="mb-14" id="experience">
    <div class="flex items-center gap-3 mb-6">
      <span class="rc-kicker">02</span>
      <h2 class="text-2xl font-semibold">Professional Experience</h2>
    </div>
    <div class="rc-timeline">
      <% site.data.cv.experience.forEach(function(exp) { %>
        <div class="rc-timeline-item rc-reveal">
          <span class="rc-timeline-dot"></span>
          <div class="rc-card rc-focus">
            <div class="rc-card-body">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold"><%= exp.position %></h3>
                <% if (exp.period) { %><span class="rc-badge-soft shrink-0 mt-0.5"><%= exp.period %></span><% } %>
              </div>
              <p class="mt-1 text-sm font-medium text-base-content/80"><%= exp.institution %></p>
              <p class="mt-2 text-sm rc-muted"><%= exp.description %></p>
              <% if (exp.responsibilities) { %>
                <ul class="mt-3 space-y-1.5">
                  <% exp.responsibilities.forEach(function(resp) { %>
                    <li class="flex items-start gap-2 text-sm rc-muted">
                      <svg class="mt-1 shrink-0 text-[color-mix(in_oklab,var(--rc-accent)_80%,transparent)]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                      <span><%= resp %></span>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Skills -->
  <% if (theme.cv_sections && theme.cv_sections.skills !== false) { %>
  <section class="mb-14" id="skills">
    <div class="flex items-center gap-3 mb-6">
      <span class="rc-kicker">03</span>
      <h2 class="text-2xl font-semibold">Skills</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <% for (const [category, skills] of Object.entries(site.data.cv.skills)) { %>
        <div class="rc-card rc-focus rc-card-body">
          <h3 class="text-base font-semibold mb-4"><%= category %></h3>
          <div class="flex flex-wrap gap-2">
            <% skills.forEach(function(skill) { %>
              <span class="rc-tag"><%= skill %></span>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- Awards & Honors -->
  <% if (theme.cv_sections && theme.cv_sections.awards !== false) { %>
  <section class="mb-14" id="awards">
    <div class="flex items-center gap-3 mb-6">
      <span class="rc-kicker">04</span>
      <h2 class="text-2xl font-semibold">Awards &amp; Honors</h2>
    </div>
    <div class="rc-timeline">
      <% site.data.cv.awards.forEach(function(award) { %>
        <div class="rc-timeline-item rc-reveal">
          <span class="rc-timeline-dot"></span>
          <div class="rc-card rc-focus">
            <div class="rc-card-body">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold"><%= award.title %></h3>
                <% if (award.date) { %><span class="rc-badge-soft shrink-0 mt-0.5"><%= award.date %></span><% } %>
              </div>
              <p class="mt-1 text-sm font-medium text-base-content/80"><%= award.issuer %></p>
              <% if (award.description) { %>
                <p class="mt-2 text-sm rc-muted"><%= award.description %></p>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Languages -->
  <% if (theme.cv_sections && theme.cv_sections.languages !== false) { %>
  <section class="mb-14" id="languages">
    <div class="flex items-center gap-3 mb-6">
      <span class="rc-kicker">05</span>
      <h2 class="text-2xl font-semibold">Languages</h2>
    </div>
    <div class="rc-card rc-focus rc-card-body">
      <div class="flex flex-wrap gap-3">
        <% site.data.cv.languages.forEach(function(lang) { %>
          <div class="flex items-center gap-2 px-4 py-2.5 rounded-[var(--rc-radius-md)] bg-[color-mix(in_oklab,var(--rc-bg-softer)_62%,transparent)] text-sm">
            <span class="font-semibold"><%= lang.name %></span>
            <span class="text-xs rc-muted">(<%= lang.level %>)</span>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Teaching -->
  <% if (theme.cv_sections && theme.cv_sections.teaching !== false && site.data.cv.teaching) { %>
  <section class="mb-14" id="teaching">
    <div class="flex items-center gap-3 mb-6">
      <span class="rc-kicker">06</span>
      <h2 class="text-2xl font-semibold">Teaching Experience</h2>
    </div>
    <div class="rc-timeline">
      <% site.data.cv.teaching.forEach(function(course) { %>
        <div class="rc-timeline-item rc-reveal">
          <span class="rc-timeline-dot"></span>
          <div class="rc-card rc-focus">
            <div class="rc-card-body">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold"><%= course.course_name %></h3>
                <% if (course.period) { %><span class="rc-badge-soft shrink-0 mt-0.5"><%= course.period %></span><% } %>
              </div>
              <p class="mt-1 text-sm font-medium text-base-content/80"><%= course.institution %><% if (course.role) { %> — <%= course.role %><% } %></p>
              <% if (course.description) { %><p class="mt-2 text-sm rc-muted"><%= course.description %></p><% } %>
              <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs rc-muted">
                <% if (course.students) { %><span>Students: <%= course.students %></span><% } %>
                <% if (course.evaluation) { %><span>Evaluation: <%= course.evaluation %></span><% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  </div><!-- /min-w-0 -->

  <aside class="hidden lg:block">
    <%- partial('partials/toc', { tocItems: cvToc }) %>
  </aside>
</div>
