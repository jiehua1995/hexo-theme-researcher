<div class="rc-section">
  <header class="text-center mb-12 rc-reveal">
    <span class="rc-kicker mx-auto">Contact</span>
    <h1 class="rc-section-title">Get in touch</h1>
    <p class="rc-muted mt-3 max-w-xl mx-auto">For collaborations, paper reviews or research inquiries, feel free to reach out — I'm always happy to talk science.</p>
  </header>

  <div class="grid gap-5 max-w-3xl mx-auto">
    <% if (theme.contact.email) { %>
      <a href="mailto:<%= theme.contact.email %>" class="rc-card rc-focus rc-card-body group">
        <div class="flex items-center gap-4">
          <span class="rc-icon">
            <i class="fas fa-envelope"></i>
          </span>
          <div class="min-w-0">
            <h2 class="text-sm font-semibold rc-muted mb-0.5">Email</h2>
            <p class="text-base font-medium truncate group-hover:text-[color-mix(in_oklab,var(--rc-accent)_90%,transparent)] transition-colors"><%= theme.contact.email %></p>
          </div>
        </div>
      </a>
    <% } %>

    <% if (theme.contact.phone) { %>
      <a href="tel:<%= theme.contact.phone %>" class="rc-card rc-focus rc-card-body group">
        <div class="flex items-center gap-4">
          <span class="rc-icon">
            <i class="fas fa-phone-alt"></i>
          </span>
          <div class="min-w-0">
            <h2 class="text-sm font-semibold rc-muted mb-0.5">Phone</h2>
            <p class="text-base font-medium truncate group-hover:text-[color-mix(in_oklab,var(--rc-accent)_90%,transparent)] transition-colors"><%= theme.contact.phone %></p>
          </div>
        </div>
      </a>
    <% } %>

    <% if (theme.contact.address) { %>
      <% if (theme.contact.google_map) { %>
        <a href="<%= theme.contact.google_map %>" target="_blank" rel="noopener noreferrer" class="rc-card rc-focus rc-card-body group">
          <div class="flex items-center gap-4">
            <span class="rc-icon">
              <i class="fas fa-map-marker-alt"></i>
            </span>
            <div class="min-w-0">
              <h2 class="text-sm font-semibold rc-muted mb-0.5">Office Location</h2>
              <p class="text-base font-medium group-hover:text-[color-mix(in_oklab,var(--rc-accent)_90%,transparent)] transition-colors"><%= theme.contact.address %></p>
            </div>
          </div>
        </a>
      <% } else { %>
        <div class="rc-card rc-focus rc-card-body">
          <div class="flex items-center gap-4">
            <span class="rc-icon">
              <i class="fas fa-map-marker-alt"></i>
            </span>
            <div class="min-w-0">
              <h2 class="text-sm font-semibold rc-muted mb-0.5">Office Location</h2>
              <p class="text-base font-medium"><%= theme.contact.address %></p>
            </div>
          </div>
        </div>
      <% } %>
    <% } %>

    <% if (theme.contact.office_hours) { %>
      <div class="rc-card rc-focus rc-card-body">
        <div class="flex items-center gap-4">
          <span class="rc-icon">
            <i class="fas fa-clock"></i>
          </span>
          <div class="min-w-0">
            <h2 class="text-sm font-semibold rc-muted mb-0.5">Office Hours</h2>
            <p class="text-base font-medium"><%= theme.contact.office_hours %></p>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>
