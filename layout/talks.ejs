<div class="rc-section">
  <header class="rc-section-head">
    <span class="rc-kicker">Academic Talks</span>
    <h1 class="rc-section-title">Talks &amp; presentations</h1>
    <p class="rc-muted mt-3 max-w-2xl">Invited talks, conference presentations and seminars. Filter by type, year or keyword.</p>
  </header>

  <!-- Filters -->
  <div class="rc-filter">
    <div class="rc-filter-field">
      <label class="rc-filter-label" for="typeFilter">Type</label>
      <select class="rc-select w-full" id="typeFilter" name="typeFilter">
        <option value="">All Types</option>
        <%
          const types = [...new Set(site.data.talks.map(t => t.type).filter(t => t))].sort();
          types.forEach(type => {
        %>
          <option value="<%= type.toLowerCase() %>"><%= type.charAt(0).toUpperCase() + type.slice(1) %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field">
      <label class="rc-filter-label" for="yearFilter">Year</label>
      <select class="rc-select w-full" id="yearFilter" name="yearFilter">
        <option value="">All Years</option>
        <%
          const years = [...new Set(site.data.talks.map(t => t.year))].sort((a, b) => b - a);
          years.forEach(year => {
        %>
          <option value="<%= year %>"><%= year %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field grow">
      <label class="rc-filter-label" for="searchInput">Search</label>
      <input type="text" placeholder="Search talks..." class="rc-input w-full" id="searchInput" />
    </div>
  </div>

  <!-- Talks list -->
  <div class="rc-timeline" id="talksList">
    <% site.data.talks.forEach(function(talk) { %>
      <div class="rc-timeline-item rc-reveal talk-item"
           data-type="<%= talk.type ? talk.type.toLowerCase() : '' %>"
           data-year="<%= talk.year %>"
           data-title="<%= (talk.title || '').toLowerCase() %>"
           data-venue="<%= (talk.venue || '').toLowerCase() %>">
        <span class="rc-timeline-dot"></span>
        <article class="rc-card rc-focus">
          <div class="rc-card-body">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-semibold leading-tight flex-1"><%= talk.title %></h2>
              <% if (talk.type) { %>
                <span class="rc-badge shrink-0 mt-1"><%= talk.type.charAt(0).toUpperCase() + talk.type.slice(1) %></span>
              <% } %>
            </div>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm rc-muted mb-4">
              <% if (talk.venue) { %>
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-building w-4 h-4"></i><%= talk.venue %></span>
              <% } %>
              <% if (talk.date) { %>
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-calendar-week w-4 h-4"></i><%= talk.date %></span>
              <% } %>
              <% if (talk.location) { %>
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-location-dot w-4 h-4"></i><%= talk.location %></span>
              <% } %>
            </div>

            <% if (talk.description) { %>
              <p class="text-sm leading-relaxed text-base-content/80 mb-4"><%= talk.description %></p>
            <% } %>

            <% if (talk.slides || talk.video || talk.paper) { %>
              <div class="flex flex-wrap gap-2">
                <% if (talk.slides) { %>
                  <a href="<%= talk.slides %>" target="_blank" rel="noopener noreferrer" class="rc-btn rc-btn-outline rc-btn-sm">
                    <i class="fa-solid fa-person-chalkboard"></i> Slides
                  </a>
                <% } %>
                <% if (talk.video) { %>
                  <a href="<%= talk.video %>" target="_blank" rel="noopener noreferrer" class="rc-btn rc-btn-outline rc-btn-sm">
                    <i class="fa-solid fa-video"></i> Video
                  </a>
                <% } %>
                <% if (talk.paper) { %>
                  <a href="<%= talk.paper %>" target="_blank" rel="noopener noreferrer" class="rc-btn rc-btn-outline rc-btn-sm">
                    <i class="fa-solid fa-book-open-reader"></i> Paper
                  </a>
                <% } %>
              </div>
            <% } %>
          </div>
        </article>
      </div>
    <% }); %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const typeFilter = document.getElementById('typeFilter');
  const yearFilter = document.getElementById('yearFilter');
  const searchInput = document.getElementById('searchInput');
  const items = document.querySelectorAll('.talk-item');

  function filter() {
    const typeVal = typeFilter.value.toLowerCase();
    const yearVal = yearFilter.value;
    const q = searchInput.value.toLowerCase().trim();

    items.forEach(item => {
      const okType = !typeVal || item.dataset.type === typeVal;
      const okYear = !yearVal || item.dataset.year === yearVal;
      const okSearch = !q ||
        (item.dataset.title || '').includes(q) ||
        (item.dataset.venue || '').includes(q);
      item.style.display = (okType && okYear && okSearch) ? '' : 'none';
    });
  }

  typeFilter.addEventListener('change', filter);
  yearFilter.addEventListener('change', filter);
  searchInput.addEventListener('input', filter);

  filter();
});
</script>
