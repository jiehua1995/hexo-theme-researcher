<div class="rc-section">
  <header class="rc-section-head">
    <span class="rc-kicker">Research Projects</span>
    <h1 class="rc-section-title">Ongoing &amp; past work</h1>
    <p class="rc-muted mt-3 max-w-2xl">A selection of research initiatives and software. Filter by status, category or keyword.</p>
  </header>

  <!-- Filters -->
  <div class="rc-filter" data-filter>
    <div class="rc-filter-field">
      <label class="rc-filter-label" for="statusFilter">Status</label>
      <select class="rc-select w-full" id="statusFilter" data-filter-type="status">
        <option value="">All Statuses</option>
        <%
          const statuses = [...new Set(site.data.projects.map(p => p.status).filter(Boolean))];
          statuses.forEach(status => {
        %>
          <option value="<%= status %>"><%= status %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field">
      <label class="rc-filter-label" for="categoryFilter">Category</label>
      <select class="rc-select w-full" id="categoryFilter" data-filter-type="category">
        <option value="">All Categories</option>
        <%
          const categories = [...new Set(site.data.projects.map(p => p.category).filter(Boolean))];
          categories.forEach(category => {
        %>
          <option value="<%= category %>"><%= category %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field grow">
      <label class="rc-filter-label" for="searchInput">Search</label>
      <input type="text" placeholder="Search projects..." class="rc-input w-full" id="searchInput" data-filter-type="search" />
    </div>

    <div class="ml-auto">
      <%- partial('partials/viewtoggle') %>
    </div>
  </div>

  <!-- Projects timeline -->
  <div class="rc-timeline" id="projectsList" data-filter-list data-view data-view-key="rc-view-projects">
    <% site.data.projects.forEach(project => { %>
      <div class="rc-timeline-item rc-reveal project-item" data-filter-item
           data-status="<%= project.status || '' %>"
           data-category="<%= project.category || '' %>"
           data-tags="<%= project.tags ? project.tags.join(',') : '' %>"
           data-title="<%= (project.title || '').toLowerCase() %>"
           data-text="<%= (project.description || '').toLowerCase() %>">
        <span class="rc-timeline-dot"></span>
        <article class="rc-card rc-focus">
          <div class="rc-card-body">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-semibold leading-tight flex-1"><%= project.title %></h2>
              <% if (project.status) { %>
                <% const statusClass = project.status === 'current' ? 'rc-badge' : (project.status === 'completed' ? 'rc-badge-soft' : 'rc-badge-neutral'); %>
                <span class="<%= statusClass %> shrink-0 mt-1"><%= project.status %></span>
              <% } %>
            </div>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm rc-muted mb-4 rc-meta-line">
              <% if (project.period) { %>
                <span class="flex items-center gap-1.5">
                  <i class="fa-solid fa-calendar-days w-4 h-4"></i>
                  <%= project.period %>
                </span>
              <% } %>
              <% if (project.category) { %>
                <span class="flex items-center gap-1.5">
                  <i class="fa-solid fa-layer-group w-4 h-4"></i>
                  <%= project.category %>
                </span>
              <% } %>
            </div>

            <% if (project.tags && project.tags.length) { %>
              <div class="flex flex-wrap gap-2 mb-4 rc-detail-only">
                <% project.tags.forEach(tag => { %>
                  <span class="rc-tag"><%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <% if (project.description) { %>
              <p class="text-sm leading-relaxed text-base-content/80 mb-4 rc-detail-only"><%= project.description %></p>
            <% } %>

            <% if (project.collaborators && project.collaborators.length) { %>
              <div class="mb-4 text-sm rc-detail-only">
                <span class="font-semibold text-base-content/80">Collaborators:</span>
                <% project.collaborators.forEach((collab, idx) => { %>
                  <a href="<%= collab.link || '#' %>" target="_blank" rel="noopener noreferrer" class="rc-tag no-underline">
                    <%= collab.name %><% if (collab.role) { %> (<%= collab.role %>)<% } %>
                  </a>
                <% }); %>
              </div>
            <% } %>

            <% if (project.publications && project.publications.length) { %>
              <div class="mb-4 space-y-1.5 rc-detail-only">
                <% project.publications.forEach(pub => { %>
                  <a href="<%= pub.link %>" target="_blank" rel="noopener noreferrer" class="flex items-start gap-2 text-sm rc-btn-link no-underline">
                    <i class="fa-solid fa-newspaper mt-0.5"></i>
                    <span><%= pub.title %></span>
                  </a>
                <% }); %>
              </div>
            <% } %>

            <% if (project.website || project.github) { %>
              <div class="flex flex-wrap gap-2 mt-4 rc-detail-only">
                <% if (project.website) { %>
                  <a href="<%= project.website %>" target="_blank" rel="noopener noreferrer" class="rc-btn rc-btn-outline rc-btn-sm">
                    <i class="fa-solid fa-link"></i> Link
                  </a>
                <% } %>
                <% if (project.github) { %>
                  <a href="<%= project.github %>" target="_blank" rel="noopener noreferrer" class="rc-btn rc-btn-outline rc-btn-sm">
                    <i class="fa-brands fa-github"></i> GitHub
                  </a>
                <% } %>
              </div>
            <% } %>
          </div>
        </article>
      </div>
    <% }); %>
  </div>
</div>
