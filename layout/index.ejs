<%
const aboutText = (theme.about || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const featuredPubs = site.data.publications ? site.data.publications.filter(p => p.featured === 'enable').slice(0, 3) : [];
const featuredProjects = site.data.projects ? site.data.projects.filter(p => p.featured === 'enable').slice(0, 3) : [];
const recentPosts = site.posts.sort('date', -1).slice(0, 3);
%>

<!-- ============ Hero ============ -->
<section class="rc-hero rc-section">
  <div class="rc-orb rc-orb-a"></div>
  <div class="rc-orb rc-orb-b"></div>
  <div class="relative grid lg:grid-cols-[1.15fr_auto] gap-12 items-center">
    <div class="relative">
      <span class="rc-hero-badge mb-6"><span class="pulse-dot"></span>Researcher · Academic Portfolio</span>
      <h1 class="rc-hero-title rc-serif font-bold"><%= config.author %></h1>
      <% if (config.subtitle) { %>
        <p class="rc-serif mt-4 text-xl sm:text-2xl text-base-content/80"><%= config.subtitle %></p>
      <% } %>
      <% if (aboutText) { %>
        <p class="mt-6 max-w-xl text-base-content/70 leading-relaxed text-[1.05rem]"><%= aboutText %></p>
      <% } %>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="<%= url_for('/publications') %>" class="rc-btn rc-btn-accent">
          <i class="fas fa-book-open"></i>Publications
        </a>
        <a href="<%= url_for('/cv') %>" class="rc-btn rc-btn-outline">
          <i class="fas fa-id-card"></i>Curriculum Vitae
        </a>
      </div>
    </div>

    <div class="hidden lg:block">
      <div style="animation: rc-float 7s ease-in-out infinite;">
        <span class="rc-avatar-ring block" style="--rc-av-size: 14rem;">
          <img src="<%= url_for(theme.avatar) %>" alt="<%= config.author %>" class="rc-avatar" />
        </span>
      </div>
    </div>
  </div>
</section>

<div class="rc-section"><hr class="rc-divider" /></div>

<!-- ============ Research Interests ============ -->
<% if (site.data.cv && site.data.cv.research_interests) { %>
<section class="rc-section rc-reveal">
  <div class="rc-section-head">
    <span class="rc-kicker">Focus Areas</span>
    <h2 class="rc-section-title text-base-content">Research Interests</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% site.data.cv.research_interests.forEach(function(area) { %>
      <div class="rc-card rc-focus">
        <div class="rc-card-body">
          <h3 class="rc-serif text-lg font-bold"><%= area.area %></h3>
          <% if (area.description) { %>
            <p class="rc-muted text-sm mt-2"><%= area.description %></p>
          <% } %>
          <% if (area.keywords && area.keywords.length > 0) { %>
            <div class="flex flex-wrap gap-1.5 mt-4">
              <% area.keywords.forEach(function(keyword) { %>
                <span class="rc-tag"><%= keyword %></span>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</section>
<% } %>

<!-- ============ Recent Notes ============ -->
<section class="rc-section rc-reveal">
  <div class="rc-section-head">
    <span class="rc-kicker">Journal</span>
    <h2 class="rc-section-title text-base-content">Recent Notes</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% recentPosts.forEach(function(post) { %>
      <article class="rc-card rc-focus flex flex-col">
        <div class="rc-card-body flex flex-col h-full">
          <div class="mb-4">
            <div class="flex items-center justify-between gap-2">
              <time class="text-xs rc-muted"><%= post.date.format('MMM DD, YYYY') %></time>
              <% if (post.categories.length > 0) { %>
                <span class="rc-badge rc-badge-neutral"><%= post.categories.toArray()[0].name %></span>
              <% } %>
            </div>
            <h3 class="rc-serif text-lg font-bold leading-snug mt-2.5 mb-0">
              <a href="<%= url_for(post.path) %>" class="hover:text-primary no-underline transition-colors duration-200">
                <%= post.title %>
              </a>
            </h3>
          </div>

          <% if (post.excerpt) { %>
            <p class="rc-muted text-sm flex-1 line-clamp-4">
              <%= post.excerpt.replace(/<[^>]*>/g, '').substring(0, 190) %>…
            </p>
          <% } else { %>
            <div class="flex-1"></div>
          <% } %>

          <% if (post.tags.length > 0) { %>
            <div class="flex flex-wrap gap-1.5 mt-4">
              <% post.tags.slice(0, 2).forEach(function(tag) { %>
                <span class="rc-tag"><%= tag.name %></span>
              <% }); %>
              <% if (post.tags.length > 2) { %>
                <span class="rc-tag rc-muted">+<%= post.tags.length - 2 %></span>
              <% } %>
            </div>
          <% } %>

          <div class="pt-4 mt-auto">
            <a href="<%= url_for(post.path) %>" class="rc-btn-link">
              Read more
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    <% }); %>
  </div>

  <div class="mt-8">
    <a href="<%= url_for('/notes') %>" class="rc-btn rc-btn-ghost">View all notes<i class="fas fa-arrow-right text-sm"></i></a>
  </div>
</section>

<!-- ============ Featured Publications ============ -->
<section class="rc-section rc-reveal">
  <div class="rc-section-head">
    <span class="rc-kicker">Output</span>
    <h2 class="rc-section-title text-base-content">Featured Publications</h2>
  </div>

  <div class="space-y-4">
    <% featuredPubs.forEach(function(pub) { %>
      <div class="rc-card rc-focus">
        <div class="rc-card-body">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="rc-serif text-lg font-bold leading-snug"><%= pub.title %></h3>
                <% if (pub.type) { %><span class="rc-badge"><%= pub.type %></span><% } %>
              </div>
              <% if (pub.authors) { %><p class="text-sm mt-1.5"><%= pub.authors %></p><% } %>
              <% if (pub.venue) { %><p class="italic text-sm rc-muted mt-0.5"><%= pub.venue %></p><% } %>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <% if (pub.year) { %><span class="rc-badge rc-badge-neutral"><%= pub.year %></span><% } %>
            </div>
          </div>
          <div class="flex flex-wrap gap-2.5 mt-4">
            <% if (pub.doi) { %>
              <a href="https://doi.org/<%= pub.doi %>" class="rc-btn rc-btn-accent rc-btn-sm" target="_blank" rel="noopener noreferrer">
                <i class="ai ai-doi"></i>DOI
              </a>
            <% } %>
            <% if (pub.pdf) { %>
              <a href="<%= pub.pdf %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer">
                <i class="fas fa-file-pdf"></i>PDF
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="mt-8">
    <a href="<%= url_for('/publications') %>" class="rc-btn rc-btn-ghost">View all publications<i class="fas fa-arrow-right text-sm"></i></a>
  </div>
</section>

<!-- ============ Featured Projects ============ -->
<% if (featuredProjects.length > 0) { %>
<section class="rc-section rc-reveal">
  <div class="rc-section-head">
    <span class="rc-kicker">Work</span>
    <h2 class="rc-section-title text-base-content">Featured Projects</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% featuredProjects.forEach(function(project) { %>
      <div class="rc-card rc-focus">
        <div class="rc-card-body">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="rc-serif text-lg font-bold leading-snug"><%= project.title %></h3>
            <% if (project.status) { %><span class="rc-badge rc-badge-neutral"><%= project.status %></span><% } %>
          </div>
          <% if (project.period) { %>
            <p class="flex items-center gap-2 text-sm rc-muted mt-2">
              <i class="far fa-calendar-alt"></i><%= project.period %>
            </p>
          <% } %>
          <% if (project.description) { %>
            <p class="mt-3 text-sm text-base-content/80"><%= project.description %></p>
          <% } %>
          <div class="flex flex-wrap gap-2.5 mt-5">
            <% if (project.website) { %>
              <a href="<%= project.website %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer">
                <i class="fas fa-external-link-alt"></i>Website
              </a>
            <% } %>
            <% if (project.github) { %>
              <a href="<%= project.github %>" class="rc-btn rc-btn-outline rc-btn-sm" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-github"></i>Code
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="mt-8">
    <a href="<%= url_for('/projects') %>" class="rc-btn rc-btn-ghost">View all projects<i class="fas fa-arrow-right text-sm"></i></a>
  </div>
</section>
<% } %>

<!-- ============ Contact / Get in touch ============ -->
<section class="rc-section rc-reveal">
  <div class="rc-section-head">
    <span class="rc-kicker">Reach out</span>
    <h2 class="rc-section-title text-base-content">Get in touch</h2>
    <p class="rc-muted mt-3 max-w-2xl">For collaborations, paper reviews or research inquiries — I'm always happy to talk science.</p>
  </div>

  <div class="rc-card rc-card-soft">
    <div class="rc-card-body">
      <div class="rc-contact-row">
        <% if (theme.contact.email) { %>
          <a href="mailto:<%= theme.contact.email %>" class="rc-contact-item">
            <i class="fas fa-envelope"></i><span><%= theme.contact.email %></span>
          </a>
        <% } %>
        <% if (theme.contact.address || theme.contact.office) { %>
          <% if (theme.contact.google_map) { %>
            <a href="<%= theme.contact.google_map %>" target="_blank" rel="noopener noreferrer" class="rc-contact-item">
              <i class="fas fa-map-marker-alt"></i><span><%= theme.contact.office || theme.contact.address %></span>
            </a>
          <% } else { %>
            <span class="rc-contact-item"><i class="fas fa-map-marker-alt"></i><span><%= theme.contact.office || theme.contact.address %></span></span>
          <% } %>
        <% } %>
        <% if (theme.contact.office_hours) { %>
          <span class="rc-contact-item">
            <i class="fas fa-clock"></i><span><%= theme.contact.office_hours %></span>
          </span>
        <% } %>
        <% if (theme.contact.phone) { %>
          <a href="tel:<%= theme.contact.phone %>" class="rc-contact-item">
            <i class="fas fa-phone"></i><span><%= theme.contact.phone %></span>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>
