<div class="rc-section">
  <header class="rc-section-head">
    <span class="rc-kicker">Research Notes</span>
    <h1 class="rc-section-title">Notes &amp; observations</h1>
    <p class="rc-muted mt-3 max-w-2xl">Short-form writeups on methods, tools and reproducible research. Filter by category, year or keyword.</p>
  </header>

  <!-- Filters -->
  <div class="rc-filter" data-filter>
    <div class="rc-filter-field">
      <label class="rc-filter-label" for="categoryFilter">Category</label>
      <select class="rc-select w-full" id="categoryFilter" name="categoryFilter" data-filter-type="category">
        <option value="">All Categories</option>
        <%
          const allCategories = [];
          site.posts.forEach(p => {
            if (p.categories.length > 0) {
              p.categories.forEach(cat => {
                if (!allCategories.includes(cat.name)) {
                  allCategories.push(cat.name);
                }
              });
            }
          });
          allCategories.sort().forEach(category => {
        %>
          <option value="<%= category %>"><%= category %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field">
      <label class="rc-filter-label" for="yearFilter">Year</label>
      <select class="rc-select w-full" id="yearFilter" name="yearFilter" data-filter-type="year">
        <option value="">All Years</option>
        <%
          const years = [...new Set(site.posts.map(p => p.date.year()))].sort((a, b) => b - a);
          years.forEach(year => {
        %>
          <option value="<%= year %>"><%= year %></option>
        <% }); %>
      </select>
    </div>

    <div class="rc-filter-field grow">
      <label class="rc-filter-label" for="searchInput">Search</label>
      <input type="text" placeholder="Search notes..." class="rc-input w-full" id="searchInput" data-filter-type="search" />
    </div>
  </div>

  <div class="text-sm rc-muted mt-4 mb-10">
    <span id="resultsCount" data-filter-count>Showing all <%= site.posts.length %> notes</span>
  </div>

  <!-- Notes grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7" id="notesContainer" data-filter-list>
    <% site.posts.sort('date', -1).forEach(function(post) { %>
      <div class="note-item rc-reveal" data-filter-item
           data-category="<%= post.categories.length > 0 ? post.categories.toArray().map(c => c.name).join(',') : '' %>"
           data-year="<%= post.date.year() %>"
           data-title="<%= post.title.toLowerCase() %>"
           data-text="<%= post.excerpt ? post.excerpt.replace(/<[^>]*>/g, '').toLowerCase() : '' %>"
           data-tags="<%= post.tags.length > 0 ? post.tags.toArray().map(t => t.name).join(',') : '' %>">
        <article class="rc-card rc-focus flex flex-col h-full">
          <div class="rc-card-body flex flex-col h-full">
            <div class="mb-4">
              <div class="flex items-center justify-between mb-2">
                <time class="text-xs rc-muted font-medium"><%= post.date.format('MMM D, YYYY') %></time>
                <% if (post.categories.length > 0) { %>
                  <span class="rc-badge"><%= post.categories.toArray()[0].name %></span>
                <% } %>
              </div>
              <h2 class="text-lg font-semibold leading-tight">
                <a href="<%= url_for(post.path) %>" class="hover:text-[color-mix(in_oklab,var(--rc-accent)_80%,transparent)] transition-colors duration-200 no-underline">
                  <%= post.title %>
                </a>
              </h2>
            </div>

            <% if (post.excerpt) { %>
              <div class="text-sm rc-muted flex-1 overflow-hidden">
                <div class="line-clamp-4">
                  <%= post.excerpt.replace(/<[^>]*>/g, '').substring(0, 150) %>…
                </div>
              </div>
            <% } else { %>
              <div class="flex-1"></div>
            <% } %>

            <div class="flex items-center justify-between mt-5">
              <% if (post.tags.length > 0) { %>
                <div class="flex flex-wrap gap-1.5">
                  <% post.tags.slice(0, 3).forEach(function(tag) { %>
                    <span class="rc-tag"><%= tag.name %></span>
                  <% }); %>
                  <% if (post.tags.length > 3) { %>
                    <span class="rc-tag">+<%= post.tags.length - 3 %></span>
                  <% } %>
                </div>
              <% } else { %>
                <div></div>
              <% } %>
              <a href="<%= url_for(post.path) %>" class="rc-btn-link" aria-label="Read more">
                Read
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </article>
      </div>
    <% }); %>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="text-center py-20 hidden" data-filter-empty>
    <div class="text-6xl opacity-20 mb-4">📝</div>
    <h3 class="text-xl font-semibold mb-2">No notes found</h3>
    <p class="rc-muted">Try adjusting your search criteria</p>
  </div>

  <% if (site.posts.length > 10) { %>
    <div class="flex justify-center mt-12">
      <button class="rc-btn rc-btn-outline" id="loadMore">Load More</button>
    </div>
  <% } %>
</div>
